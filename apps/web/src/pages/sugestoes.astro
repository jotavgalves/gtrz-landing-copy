---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Turnstile from '@/components/Turnstile.astro';
import { getHomePage } from '@/lib/cms';
import type { Locale } from '@/lib/cms';

const locale:Locale=Astro.url.searchParams.get('lang')==='es'?'es':'pt-BR';
const es=locale==='es';
const site=await getHomePage();
const apiBase=import.meta.env.PUBLIC_API_BASE||'';
const prefilledEvent=String(Astro.url.searchParams.get('evento')||'').slice(0,80);
const sourcePath=String(Astro.url.searchParams.get('origem')||'/sugestoes').slice(0,220);
const canonicalPt=new URL('/sugestoes',Astro.url.origin).toString();
const canonicalEs=new URL('/sugestoes?lang=es',Astro.url.origin).toString();

const copy=es?{
  eyebrow:'SUGERENCIAS',
  title:'AYÚDANOS A HACERLO MEJOR.',
  intro:'Cuéntanos qué funcionó, qué puede mejorar o qué te gustaría encontrar en una próxima edición.',
  event:'¿SOBRE QUÉ FIESTA ESTÁS HABLANDO?',
  eventPlaceholder:'Ej.: MISTÉRIO',
  identity:'¿CÓMO QUIERES IDENTIFICARTE?',
  anonymous:'Anónimo',
  identified:'Quiero poner mi nombre',
  name:'TU NOMBRE',
  namePlaceholder:'Escribe tu nombre',
  message:'TU SUGERENCIA',
  messagePlaceholder:'Escribe aquí tu sugerencia, crítica o idea…',
  privacy:'Tu mensaje será utilizado para analizar y mejorar las experiencias de GTRZ. Si eliges el envío anónimo, no guardaremos un nombre junto a la sugerencia.',
  privacyLink:'Privacidad',
  submit:'ENVIAR SUGERENCIA',
  sending:'ENVIANDO…',
  successTitle:'RECIBIDO.',
  successBody:'Gracias por ayudar a mejorar las próximas experiencias de GTRZ.',
  back:'VOLVER A LOS EVENTOS',
  invalid:'Revisa los campos obligatorios.',
  error:'No fue posible enviar la sugerencia. Inténtalo de nuevo.',
  rate:'Has enviado demasiadas solicitudes. Inténtalo más tarde.',
  challenge:'No fue posible validar el envío.'
}:{
  eyebrow:'SUGESTÕES',
  title:'AJUDE A GENTE A FAZER MELHOR.',
  intro:'Conte o que funcionou, o que pode melhorar ou o que você gostaria de encontrar em uma próxima edição.',
  event:'SOBRE QUAL FESTA VOCÊ ESTÁ FALANDO?',
  eventPlaceholder:'Ex.: MISTÉRIO',
  identity:'COMO QUER SE IDENTIFICAR?',
  anonymous:'Anônimo',
  identified:'Quero colocar meu nome',
  name:'SEU NOME',
  namePlaceholder:'Digite seu nome',
  message:'SUA SUGESTÃO',
  messagePlaceholder:'Escreva aqui sua sugestão, crítica ou ideia…',
  privacy:'Sua mensagem será utilizada para analisar e melhorar as experiências da GTRZ. Se escolher o envio anônimo, nenhum nome será armazenado junto à sugestão.',
  privacyLink:'Privacidade',
  submit:'ENVIAR SUGESTÃO',
  sending:'ENVIANDO…',
  successTitle:'RECEBEMOS.',
  successBody:'Obrigado por ajudar a melhorar as próximas experiências da GTRZ.',
  back:'VOLTAR AOS EVENTOS',
  invalid:'Revise os campos obrigatórios.',
  error:'Não foi possível enviar a sugestão. Tente novamente.',
  rate:'Muitas tentativas foram enviadas. Tente novamente mais tarde.',
  challenge:'Não foi possível validar o envio.'
};
---
<SiteLayout
  locale={locale}
  settings={site.settings}
  title={es?'Sugerencias · GTRZ Eventos':'Sugestões · GTRZ Eventos'}
  description={copy.intro}
  canonicalUrl={es?canonicalEs:canonicalPt}
  alternatePtUrl={canonicalPt}
  alternateEsUrl={canonicalEs}
>
  <main class="feedback-page">
    <section class="feedback-hero">
      <div class="feedback-shell">
        <span class="feedback-eyebrow">{copy.eyebrow}</span>
        <h1>{copy.title}</h1>
        <p>{copy.intro}</p>
      </div>
    </section>

    <section class="feedback-form-section" data-section="feedback_form">
      <div class="feedback-shell feedback-grid">
        <div class="feedback-side">
          <span>GTRZ / FEEDBACK</span>
          <p>{es?'Tu opinión llega directamente al equipo responsable por las producciones.':'Sua opinião chega diretamente à equipe responsável pelas produções.'}</p>
        </div>

        <form class="feedback-form" data-feedback-form novalidate>
          <label class="feedback-field">
            <span>{copy.event} *</span>
            <input name="eventName" value={prefilledEvent} maxlength="80" minlength="2" required autocomplete="off" placeholder={copy.eventPlaceholder} />
          </label>

          <fieldset class="feedback-identity">
            <legend>{copy.identity}</legend>
            <div>
              <label><input type="radio" name="identity" value="anonymous" checked /><span>{copy.anonymous}</span></label>
              <label><input type="radio" name="identity" value="named" /><span>{copy.identified}</span></label>
            </div>
          </fieldset>

          <label class="feedback-field feedback-name" data-feedback-name hidden>
            <span>{copy.name} *</span>
            <input name="name" maxlength="80" minlength="2" autocomplete="name" placeholder={copy.namePlaceholder} />
          </label>

          <label class="feedback-field">
            <span>{copy.message} *</span>
            <textarea name="message" maxlength="1500" minlength="5" required placeholder={copy.messagePlaceholder}></textarea>
            <small><b data-feedback-count>0</b> / 1500</small>
          </label>

          <label class="feedback-honeypot" aria-hidden="true">
            <span>Website</span>
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>

          <Turnstile action="event-feedback" />

          <div class="feedback-privacy">
            <p>{copy.privacy}</p>
            <a href={es?'/privacidade?lang=es':'/privacidade'}>{copy.privacyLink} →</a>
          </div>

          <div class="feedback-submit-row">
            <p data-feedback-message role="status"></p>
            <button type="submit" data-feedback-submit>{copy.submit}</button>
          </div>
        </form>

        <div class="feedback-success" data-feedback-success hidden>
          <span>{copy.eyebrow}</span>
          <h2>{copy.successTitle}</h2>
          <p>{copy.successBody}</p>
          <a href={es?'/?lang=es#eventos':'/#eventos'}>{copy.back} →</a>
        </div>
      </div>
    </section>
  </main>

  <script define:vars={{apiBase,locale,sourcePath,copy}}>
    const form=document.querySelector('[data-feedback-form]');
    const success=document.querySelector('[data-feedback-success]');
    if(form){
      const nameWrap=form.querySelector('[data-feedback-name]');
      const nameInput=form.elements.namedItem('name');
      const messageInput=form.elements.namedItem('message');
      const counter=form.querySelector('[data-feedback-count]');
      const status=form.querySelector('[data-feedback-message]');
      const submit=form.querySelector('[data-feedback-submit]');

      const syncIdentity=()=>{
        const mode=form.querySelector('input[name="identity"]:checked')?.value||'anonymous';
        const named=mode==='named';
        nameWrap.hidden=!named;
        nameInput.required=named;
        if(!named)nameInput.value='';
      };

      form.querySelectorAll('input[name="identity"]').forEach(input=>input.addEventListener('change',syncIdentity));
      messageInput.addEventListener('input',()=>{counter.textContent=String(messageInput.value.length)});
      syncIdentity();

      form.addEventListener('submit',async(event)=>{
        event.preventDefault();
        status.textContent='';
        const data=new FormData(form);
        const anonymous=String(data.get('identity')||'anonymous')!=='named';
        const eventName=String(data.get('eventName')||'').trim();
        const name=String(data.get('name')||'').trim();
        const message=String(data.get('message')||'').trim();

        if(eventName.length<2||message.length<5||(!anonymous&&name.length<2)){
          status.textContent=copy.invalid;
          return;
        }

        submit.disabled=true;
        submit.textContent=copy.sending;

        try{
          const turnstileToken=String(data.get('cf-turnstile-response')||'');
          const response=await fetch(`${apiBase}/api/public/feedback`,{
            method:'POST',
            headers:{'content-type':'application/json'},
            body:JSON.stringify({
              eventName,
              anonymous,
              name:anonymous?null:name,
              message,
              locale,
              sourcePath,
              website:String(data.get('website')||''),
              turnstileToken
            })
          });
          const result=await response.json().catch(()=>({}));
          if(!response.ok){
            if(result.error==='rate_limited')throw new Error(copy.rate);
            if(result.error==='challenge_failed')throw new Error(copy.challenge);
            if(result.error==='invalid_form')throw new Error(copy.invalid);
            throw new Error(copy.error);
          }

          window.gtrzTrack?.('feedback_submit',{section:'feedback_form',eventName});
          form.hidden=true;
          success.hidden=false;
          success.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'center'});
        }catch(error){
          status.textContent=error?.message||copy.error;
          if(window.turnstile)try{window.turnstile.reset()}catch{}
        }finally{
          submit.disabled=false;
          submit.textContent=copy.submit;
        }
      });
    }
  </script>
</SiteLayout>

<style>
  .feedback-page{background:#090909;color:#fff}
  .feedback-shell{width:min(calc(100% - 32px),1080px);margin-inline:auto}
  .feedback-hero{
    padding:142px 0 64px;
    border-bottom:1px solid rgba(255,255,255,.08);
    background:radial-gradient(55% 90% at 100% 0%,rgba(255,36,26,.13),transparent 72%),#090909;
  }
  .feedback-eyebrow,.feedback-side>span,.feedback-success>span{
    color:#ff241a;font-size:.58rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase;
  }
  .feedback-hero h1,.feedback-success h2{
    max-width:900px;margin:18px 0 0;font-family:'Barlow Condensed','Arial Narrow',sans-serif;
    font-size:clamp(4rem,10vw,7.6rem);font-weight:900;line-height:.84;letter-spacing:-.04em;text-transform:uppercase;
  }
  .feedback-hero p{max-width:650px;margin:24px 0 0;color:#958e89;font-size:1rem;line-height:1.7}
  .feedback-form-section{padding:42px 0 100px}
  .feedback-grid{display:grid;grid-template-columns:190px minmax(0,1fr);gap:42px;align-items:start}
  .feedback-side{position:sticky;top:100px;padding-top:4px}
  .feedback-side p{margin:13px 0 0;color:#615b57;font-size:.72rem;line-height:1.65}
  .feedback-form{display:grid;gap:25px}
  .feedback-field{display:grid;gap:9px}
  .feedback-field>span,.feedback-identity legend{
    color:#8e8682;font-size:.63rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase;
  }
  .feedback-field input,.feedback-field textarea{
    width:100%;box-sizing:border-box;border:1px solid #2d2b2a;border-radius:14px;background:#0d0d0d;color:#fff;
    padding:16px 17px;font:inherit;outline:none;transition:border-color .18s ease,box-shadow .18s ease;
  }
  .feedback-field input{min-height:54px}
  .feedback-field textarea{min-height:230px;resize:vertical;line-height:1.65}
  .feedback-field input:focus,.feedback-field textarea:focus{border-color:#ff241a;box-shadow:0 0 0 3px rgba(255,36,26,.08)}
  .feedback-field small{justify-self:end;color:#514b48;font-size:.58rem}
  .feedback-identity{margin:0;padding:0;border:0}
  .feedback-identity>div{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:10px}
  .feedback-identity label{position:relative}
  .feedback-identity input{position:absolute;opacity:0;pointer-events:none}
  .feedback-identity label span{
    min-height:54px;display:flex;align-items:center;padding:0 16px;border:1px solid #2d2b2a;border-radius:14px;
    color:#918985;font-size:.72rem;font-weight:800;cursor:pointer;transition:.18s ease;
  }
  .feedback-identity input:checked+span{border-color:#ff241a;background:rgba(255,36,26,.08);color:#fff}
  .feedback-name[hidden],.feedback-honeypot{display:none!important}
  .feedback-privacy{padding:17px 0;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08)}
  .feedback-privacy p{margin:0;color:#716a66;font-size:.68rem;line-height:1.6}
  .feedback-privacy a{display:inline-block;margin-top:8px;color:#aaa19d;font-size:.6rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .feedback-submit-row{display:flex;align-items:center;justify-content:space-between;gap:20px}
  .feedback-submit-row p{margin:0;color:#d77a74;font-size:.68rem;line-height:1.5}
  .feedback-submit-row button{
    flex:none;min-height:50px;border:0;border-radius:999px;padding:0 24px;background:#ff241a;color:#fff;
    font-size:.65rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase;cursor:pointer;
  }
  .feedback-submit-row button:disabled{opacity:.55;cursor:wait}
  .feedback-success{grid-column:2;padding:30px 0 20px}
  .feedback-success[hidden]{display:none}
  .feedback-success h2{font-size:clamp(4rem,8vw,6.6rem)}
  .feedback-success p{max-width:600px;margin:22px 0;color:#938b87;line-height:1.7}
  .feedback-success a{display:inline-flex;margin-top:12px;color:#fff;font-size:.64rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}
  @media(max-width:760px){
    .feedback-shell{width:min(calc(100% - 28px),1080px)}
    .feedback-hero{padding:118px 0 48px}
    .feedback-form-section{padding:32px 0 76px}
    .feedback-grid{grid-template-columns:1fr;gap:26px}
    .feedback-side{position:static;display:none}
    .feedback-identity>div{grid-template-columns:1fr}
    .feedback-submit-row{align-items:stretch;flex-direction:column}
    .feedback-submit-row button{width:100%}
    .feedback-success{grid-column:1;padding-top:10px}
  }
</style>
