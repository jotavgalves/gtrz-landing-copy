        window.gtrzTrack?.('freelancer_form_submit',{section:'freelancer_form'});setMessage(copy.success);const selectedRoleText=[...selectedRoles].map(x=>upper(x.value)).join(', ');const text=['CANDIDATURA GTRZ','',`PROTOCOLO: ${result.id}`,`NOME: ${upper(name)}`,`CPF: ${digits(cpf)}`,`DATA DE NASCIMENTO: ${birthDisplay}`,`WHATSAPP: ${formatPhone(whatsapp)}`,`E-MAIL: ${upper(email)}`,postalCode?`CEP: ${formatCep(postalCode)}`:'',`ESTADO: ${upper(stateSelect.value)}`,`CIDADE: ${upper(citySelect.value)}`,`BAIRRO: ${upper(neighborhood)}`,`RUA: ${upper(street)}`,`NÚMERO: ${upper(addressNumber)}`,complement?`COMPLEMENTO: ${upper(complement)}`:'',`FUNÇÕES: ${selectedRoleText}`,otherInput.value?`OUTRA FUNÇÃO: ${upper(otherInput.value)}`:'',form.elements.portfolioUrl.value?`PORTFÓLIO: ${form.elements.portfolioUrl.value}`:'',availability?`OBSERVAÇÕES: ${upper(availability)}`:'',resume?`CURRÍCULO: ${resume.name}`:'CURRÍCULO: NÃO ANEXADO',`PRIVACIDADE: ACEITE REGISTRADO · VERSÃO ${privacyNoticeVersion}`].filter(Boolean).join('\n');if(result.whatsapp)window.location.href=`https://wa.me/${digits(result.whatsapp)}?text=${encodeURIComponent(text)}`
