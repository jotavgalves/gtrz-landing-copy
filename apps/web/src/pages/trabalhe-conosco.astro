---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Turnstile from '@/components/Turnstile.astro';
import { getHomePage } from '@/lib/cms';
import type { Locale } from '@/lib/cms';

const locale: Locale = Astro.url.searchParams.get('lang') === 'es' ? 'es' : 'pt-BR';
const es = locale === 'es';
const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const site = await getHomePage();
const recruitment = (site.settings as any)?.recruitment || {};
const defaultRoles = ['DJ','FOTÓGRAFO(A)','VIDEOMAKER','SEGURANÇA','BOMBEIRO(A)','RECEPÇÃO','BARMAN','GARÇOM','LIMPEZA','OUTROS'];
const roles = Array.isArray(recruitment.roles) && recruitment.roles.length ? recruitment.roles : defaultRoles;
const privacyNoticeVersion='1.0';
const availabilityLimit=800;
const copy = es ? {
  eyebrow:'TRABAJA CON NOSOTROS',title:'ENTRA EN LA RED GTRZ.',intro:'Registra tu perfil para futuras producciones. Puedes seleccionar todas las funciones en las que quieras participar.',identity:'DATOS PERSONALES',location:'DÓNDE ESTÁS',roles:'FUNCIONES',materials:'CURRÍCULO Y PORTAFOLIO',privacy:'PRIVACIDAD Y DATOS',name:'NOMBRE COMPLETO',cpf:'CPF',cpfHelp:'SOLICITAMOS EL CPF PARA VALIDAR LA CONSISTENCIA DEL REGISTRO, INDIVIDUALIZAR LA CANDIDATURA, EVITAR DUPLICIDADES Y, SI HAY CONTRATACIÓN, UTILIZAR LA IDENTIFICACIÓN NECESARIA PARA FORMALIZAR CONTRATOS Y PROCEDIMIENTOS RELACIONADOS CON LA PRESTACIÓN DE SERVICIOS.',birth:'FECHA DE NACIMIENTO',whatsapp:'WHATSAPP',email:'E-MAIL',cep:'CEP',state:'ESTADO',city:'CIUDAD',neighborhood:'BARRIO',street:'CALLE / DIRECCIÓN',number:'NÚMERO',complement:'COMPLEMENTO · OPCIONAL',other:'DESCRIBE LA OTRA FUNCIÓN',resume:'CURRÍCULO EN PDF · OPCIONAL',portfolio:'PORTAFOLIO · OPCIONAL',availability:'DISPONIBILIDAD / OBSERVACIONES · OPCIONAL',submit:'ENVIAR CANDIDATURA Y CONTINUAR EN WHATSAPP',loading:'CARGANDO…',choose:'SELECCIONA',success:'CANDIDATURA GUARDADA. ABRIENDO WHATSAPP…',errorTitle:'REVISA TU CANDIDATURA',errorIntro:'CORRIGE LOS SIGUIENTES CAMPOS ANTES DE CONTINUAR:',close:'ENTENDIDO',ageTitle:'REQUISITO DE EDAD',ageMessage:'ES NECESARIO TENER AL MENOS 18 AÑOS. SE SOLICITARÁ UN DOCUMENTO PARA COMPROBAR LA EDAD; CAMBIAR LA FECHA INFORMADA NO SUSTITUYE ESA COMPROBACIÓN.',cepHint:'INFORMA EL CEP PARA COMPLETAR AUTOMÁTICAMENTE ESTADO, CIUDAD, BARRIO Y DIRECCIÓN.',cepFound:'DIRECCIÓN ENCONTRADA. REVISA LOS DATOS Y COMPLETA EL NÚMERO.',cepNotFound:'NO FUE POSIBLE ENCONTRAR ESTE CEP. PUEDES COMPLETAR LA DIRECCIÓN MANUALMENTE.',privacyText:'Los datos informados serán tratados por GTRZ exclusivamente para reclutamiento, mantenimiento de una base de profesionales, contacto para futuras oportunidades, contratación y gestión de servicios. GTRZ no venderá tus datos, no los utilizará para publicidad de terceros y no realizará usos incompatibles con estas finalidades. Los datos podrán conservarse mientras sean pertinentes y necesarios para estas finalidades, respetando la legislación aplicable y los derechos del titular.',privacyCheck:'DECLARO QUE LEÍ Y COMPRENDÍ EL AVISO DE PRIVACIDAD Y AUTORIZO EL TRATAMIENTO DE MIS DATOS PARA LAS FINALIDADES INFORMADAS.',privacyLink:'LEER POLÍTICA COMPLETA DE PRIVACIDAD',privacyError:'DEBES ACEPTAR EL AVISO DE PRIVACIDAD PARA ENVIAR LA CANDIDATURA.'
} : {
  eyebrow:'TRABALHE CONOSCO',title:'ENTRE PARA A REDE GTRZ.',intro:'Cadastre seu perfil para futuras produções. Você pode selecionar todas as funções em que está disposto a trabalhar.',identity:'DADOS PESSOAIS',location:'ONDE VOCÊ ESTÁ',roles:'FUNÇÕES',materials:'CURRÍCULO E PORTFÓLIO',privacy:'PRIVACIDADE E DADOS',name:'NOME COMPLETO',cpf:'CPF',cpfHelp:'SOLICITAMOS O CPF PARA VALIDAR A CONSISTÊNCIA DO CADASTRO, INDIVIDUALIZAR A CANDIDATURA, EVITAR DUPLICIDADES E, EM CASO DE CONTRATAÇÃO, UTILIZAR A IDENTIFICAÇÃO NECESSÁRIA À FORMALIZAÇÃO DE CONTRATOS E AOS PROCEDIMENTOS RELACIONADOS À PRESTAÇÃO DE SERVIÇOS.',birth:'DATA DE NASCIMENTO',whatsapp:'WHATSAPP',email:'E-MAIL',cep:'CEP',state:'ESTADO',city:'CIDADE',neighborhood:'BAIRRO',street:'RUA / LOGRADOURO',number:'NÚMERO',complement:'COMPLEMENTO · OPCIONAL',other:'DESCREVA A OUTRA FUNÇÃO',resume:'CURRÍCULO EM PDF · OPCIONAL',portfolio:'PORTFÓLIO · OPCIONAL',availability:'DISPONIBILIDADE / OBSERVAÇÕES · OPCIONAL',submit:'ENVIAR CANDIDATURA E CONTINUAR NO WHATSAPP',loading:'CARREGANDO…',choose:'SELECIONE',success:'CANDIDATURA SALVA. ABRINDO O WHATSAPP…',errorTitle:'REVISE SUA CANDIDATURA',errorIntro:'CORRIJA OS ITENS ABAIXO ANTES DE CONTINUAR:',close:'ENTENDI',ageTitle:'REQUISITO DE IDADE',ageMessage:'É NECESSÁRIO TER PELO MENOS 18 ANOS. SERÁ SOLICITADO DOCUMENTO PARA COMPROVAÇÃO DA IDADE; ALTERAR A DATA INFORMADA NÃO SUBSTITUI ESSA COMPROVAÇÃO.',cepHint:'INFORME O CEP PARA PREENCHER AUTOMATICAMENTE ESTADO, CIDADE, BAIRRO E RUA.',cepFound:'ENDEREÇO ENCONTRADO. CONFIRA OS DADOS E PREENCHA O NÚMERO.',cepNotFound:'NÃO FOI POSSÍVEL LOCALIZAR ESTE CEP. VOCÊ PODE PREENCHER O ENDEREÇO MANUALMENTE.',privacyText:'Os dados informados serão tratados pela GTRZ exclusivamente para recrutamento, manutenção de banco de profissionais, contato para futuras oportunidades, contratação e gestão da prestação de serviços. A GTRZ não venderá seus dados, não os utilizará para publicidade de terceiros e não realizará usos incompatíveis com essas finalidades. Os dados poderão ser conservados enquanto forem pertinentes e necessários para essas finalidades, respeitada a legislação aplicável e os direitos do titular.',privacyCheck:'DECLARO QUE LI E COMPREENDI O AVISO DE PRIVACIDADE E AUTORIZO O TRATAMENTO DOS MEUS DADOS PARA AS FINALIDADES INFORMADAS.',privacyLink:'LER POLÍTICA COMPLETA DE PRIVACIDADE',privacyError:'É NECESSÁRIO ACEITAR O AVISO DE PRIVACIDADE PARA ENVIAR A CANDIDATURA.'
};
---
<SiteLayout locale={locale} title={es ? 'Trabaja con nosotros · GTRZ' : 'Trabalhe conosco · GTRZ'} settings={site.settings}>
  <main class="recruitment-page">
    <section class="recruitment-hero" data-section="freelancer_intro">
      <div class="shell recruitment-hero-grid"><div><span class="eyebrow">{copy.eyebrow}</span><h1 class="display">{copy.title}</h1></div><p>{copy.intro}</p></div>
    </section>
    <section class="recruitment-section" data-section="freelancer_form">
      <div class="shell recruitment-shell">
        <form data-public-form="freelancers" novalidate>
          <fieldset class="recruitment-block">
            <legend><span>01</span>{copy.identity}</legend>
            <div class="recruitment-grid identity-grid">
              <label><span>{copy.name} *</span><input name="name" required maxlength="160" autocomplete="name" data-upper data-person-name /></label>
              <label class="cpf-field"><span>{copy.cpf} *</span><input name="cpf" required inputmode="numeric" autocomplete="off" data-cpf placeholder="000.000.000-00" maxlength="14" /><small class="field-help">{copy.cpfHelp}</small></label>
              <label><span>{copy.birth} *</span><input name="birthDate" required inputmode="numeric" autocomplete="bday" data-birth placeholder="DD/MM/AAAA" maxlength="10" /></label>
              <label><span>{copy.whatsapp} *</span><input name="whatsapp" required inputmode="tel" autocomplete="tel" data-phone placeholder="81 90000-0000" maxlength="13" /></label>
              <label class="wide"><span>{copy.email} *</span><input name="email" type="email" required maxlength="200" autocomplete="email" placeholder="NOME@EMAIL.COM" data-email /></label>
            </div>
          </fieldset>

          <fieldset class="recruitment-block">
            <legend><span>02</span>{copy.location}</legend>
            <p class="block-help address-help">{copy.cepHint}</p>
            <div class="recruitment-grid three address-grid">
              <label><span>{copy.cep}</span><input name="postalCode" inputmode="numeric" autocomplete="postal-code" data-cep placeholder="00000-000" maxlength="9" /></label>
              <label><span>{copy.state} *</span><select name="state" required data-state><option value="">{copy.loading}</option></select></label>
              <label><span>{copy.city} *</span><select name="city" required data-city disabled><option value="">{copy.choose}</option></select></label>
              <label><span>{copy.neighborhood} *</span><input name="neighborhood" required maxlength="120" data-upper autocomplete="address-level3" /></label>
              <label class="span-two"><span>{copy.street} *</span><input name="street" required maxlength="180" data-upper autocomplete="address-line1" /></label>
              <label><span>{copy.number} *</span><input name="addressNumber" required maxlength="30" data-upper autocomplete="address-line2" /></label>
              <label class="span-two"><span>{copy.complement}</span><input name="complement" maxlength="160" data-upper autocomplete="address-line3" /></label>
            </div>
            <p class="cep-status" data-cep-status aria-live="polite"></p>
          </fieldset>

          <fieldset class="recruitment-block">
            <legend><span>03</span>{copy.roles}</legend>
            <p class="block-help">{es ? 'SELECCIONA UNA O MÁS OPCIONES.' : 'MARQUE UMA OU MAIS OPÇÕES.'}</p>
            <div class="role-picker" data-role-picker>{roles.map((role:string) => <label class="role-choice"><input type="checkbox" name="roles" value={String(role).toLocaleUpperCase('pt-BR')} /><span>{String(role).toLocaleUpperCase('pt-BR')}</span></label>)}</div>
            <label class="other-role" hidden data-other-role><span>{copy.other} *</span><input name="otherRole" maxlength="160" data-upper /></label>
          </fieldset>

          <fieldset class="recruitment-block">
            <legend><span>04</span>{copy.materials}</legend>
            <div class="recruitment-grid">
              <label class="file-field"><span>{copy.resume}</span><input name="resume" type="file" accept="application/pdf,.pdf" /><small>PDF · MÁX. 5 MB</small></label>
              <label><span>{copy.portfolio}</span><input name="portfolioUrl" type="url" maxlength="1000" placeholder="HTTPS://" /></label>
              <label class="wide observation-field"><span>{copy.availability}</span><textarea name="availability" maxlength={availabilityLimit} data-upper data-availability rows="5"></textarea><small class="char-counter"><span data-availability-count>0</span> / {availabilityLimit}</small></label>
            </div>
          </fieldset>

          <fieldset class="recruitment-block privacy-block">
            <legend><span>05</span>{copy.privacy}</legend>
            <p class="privacy-copy">{copy.privacyText}</p>
            <a class="privacy-link" href={`/privacidade-profissionais?lang=${es?'es':'pt-BR'}`} target="_blank" rel="noreferrer">{copy.privacyLink}</a>
            <label class="privacy-consent"><input type="checkbox" name="privacyAccepted" value="1" data-privacy-consent /><span>{copy.privacyCheck}</span></label>
            <input type="hidden" name="privacyNoticeVersion" value={privacyNoticeVersion} />
            <input type="hidden" name="privacyNoticeLocale" value={es?'es':'pt-BR'} />
          </fieldset>

          <Turnstile action="freelancer" />
          <div class="recruitment-submit"><p data-form-message aria-live="polite"></p><button class="button primary" type="submit">{copy.submit}</button></div>
        </form>
      </div>
    </section>
  </main>

  <div class="form-modal" hidden data-error-modal role="dialog" aria-modal="true" aria-labelledby="recruitment-modal-title">
    <button class="form-modal-backdrop" type="button" aria-label={copy.close} data-modal-close></button>
    <div class="form-modal-card"><div class="form-modal-mark" aria-hidden="true">!</div><h2 id="recruitment-modal-title" data-modal-title>{copy.errorTitle}</h2><p data-modal-intro>{copy.errorIntro}</p><ul data-modal-errors></ul><button class="button primary" type="button" data-modal-close>{copy.close}</button></div>
  </div>

  <script is:inline define:vars={{ apiBase, copy, es, privacyNoticeVersion, availabilityLimit }}>
    const form=document.querySelector('[data-public-form="freelancers"]');
    const msg=form?.querySelector('[data-form-message]');const stateSelect=form?.querySelector('[data-state]');const citySelect=form?.querySelector('[data-city]');const otherWrap=form?.querySelector('[data-other-role]');const otherInput=form?.querySelector('[name="otherRole"]');const nameInput=form?.querySelector('[data-person-name]');const cpfInput=form?.querySelector('[data-cpf]');const phoneInput=form?.querySelector('[data-phone]');const birthInput=form?.querySelector('[data-birth]');const emailInput=form?.querySelector('[data-email]');const cepInput=form?.querySelector('[data-cep]');const cepStatus=form?.querySelector('[data-cep-status]');const neighborhoodInput=form?.querySelector('[name="neighborhood"]');const streetInput=form?.querySelector('[name="street"]');const numberInput=form?.querySelector('[name="addressNumber"]');const complementInput=form?.querySelector('[name="complement"]');const privacyInput=form?.querySelector('[data-privacy-consent]');const availabilityInput=form?.querySelector('[data-availability]');const availabilityCount=form?.querySelector('[data-availability-count]');const modal=document.querySelector('[data-error-modal]');const modalTitle=modal?.querySelector('[data-modal-title]');const modalIntro=modal?.querySelector('[data-modal-intro]');const modalErrors=modal?.querySelector('[data-modal-errors]');let started=false,lastCep='';
    const upper=v=>String(v||'').toLocaleUpperCase('pt-BR');const digits=v=>String(v||'').replace(/\D/g,'');const option=(value,label)=>{const o=document.createElement('option');o.value=value;o.textContent=label;return o};const setMessage=text=>{if(msg)msg.textContent=text||''};const setCepStatus=(text,tone='')=>{if(!cepStatus)return;cepStatus.textContent=text||'';cepStatus.dataset.tone=tone};
    const validCpf=raw=>{const cpf=digits(raw);if(cpf.length!==11||/^(\d)\1{10}$/.test(cpf))return false;const calc=len=>{let sum=0;for(let i=0;i<len;i++)sum+=Number(cpf[i])*(len+1-i);const r=(sum*10)%11;return r===10?0:r};return calc(9)===Number(cpf[9])&&calc(10)===Number(cpf[10])};
    const validEmail=value=>/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/i.test(String(value||'').trim());
    const formatCpf=value=>{const d=digits(value).slice(0,11);return d.replace(/^(\d{3})(\d)/,'$1.$2').replace(/^(\d{3})\.(\d{3})(\d)/,'$1.$2.$3').replace(/\.(\d{3})(\d)/,'.$1-$2')};
    const formatPhone=value=>{const d=digits(value).slice(0,11);if(d.length<=2)return d;if(d.length<=7)return `${d.slice(0,2)} ${d.slice(2)}`;return `${d.slice(0,2)} ${d.slice(2,7)}-${d.slice(7)}`};
    const formatCep=value=>{const d=digits(value).slice(0,8);return d.length<=5?d:`${d.slice(0,5)}-${d.slice(5)}`};
    const formatDate=value=>{const d=digits(value).slice(0,8);if(d.length<=2)return d;if(d.length<=4)return `${d.slice(0,2)}/${d.slice(2)}`;return `${d.slice(0,2)}/${d.slice(2,4)}/${d.slice(4)}`};
    const dateToIso=value=>{const m=String(value||'').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);if(!m)return '';const iso=`${m[3]}-${m[2]}-${m[1]}`;const d=new Date(`${iso}T12:00:00Z`);if(Number.isNaN(d.getTime())||d.getUTCFullYear()!==Number(m[3])||d.getUTCMonth()+1!==Number(m[2])||d.getUTCDate()!==Number(m[1]))return '';return iso};
    const ageFromIso=iso=>{if(!iso)return -1;const birth=new Date(`${iso}T12:00:00Z`),now=new Date();let age=now.getUTCFullYear()-birth.getUTCFullYear();const m=now.getUTCMonth()-birth.getUTCMonth();if(m<0||(m===0&&now.getUTCDate()<birth.getUTCDate()))age--;return age};
    const openModal=(errors,{age=false}={})=>{if(!modal)return;modalTitle.textContent=age?copy.ageTitle:copy.errorTitle;modalIntro.textContent=age?copy.ageMessage:copy.errorIntro;modalErrors.innerHTML='';if(!age)errors.forEach(text=>{const li=document.createElement('li');li.textContent=text;modalErrors.append(li)});modal.hidden=false;document.documentElement.style.overflow='hidden'};
    const closeModal=()=>{if(!modal)return;modal.hidden=true;document.documentElement.style.overflow=''};modal?.querySelectorAll('[data-modal-close]').forEach(button=>button.addEventListener('click',closeModal));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!modal?.hidden)closeModal()});
    form?.querySelectorAll('[data-upper]').forEach(el=>el.addEventListener('input',()=>{const s=el.selectionStart;el.value=upper(el.value);try{el.setSelectionRange(s,s)}catch{}}));nameInput?.addEventListener('beforeinput',e=>{if(e.data&&/\d/.test(e.data))e.preventDefault()});nameInput?.addEventListener('input',()=>{const s=nameInput.selectionStart;nameInput.value=upper(nameInput.value.replace(/\d/g,''));try{nameInput.setSelectionRange(s,s)}catch{}});cpfInput?.addEventListener('input',()=>{cpfInput.value=formatCpf(cpfInput.value)});phoneInput?.addEventListener('input',()=>{phoneInput.value=formatPhone(phoneInput.value)});birthInput?.addEventListener('input',()=>{birthInput.value=formatDate(birthInput.value)});cepInput?.addEventListener('input',()=>{cepInput.value=formatCep(cepInput.value)});emailInput?.addEventListener('input',()=>{emailInput.value=upper(emailInput.value)});availabilityInput?.addEventListener('input',()=>{if(availabilityCount)availabilityCount.textContent=String(availabilityInput.value.length)});form?.addEventListener('focusin',()=>{if(!started){started=true;window.gtrzTrack?.('freelancer_form_start',{section:'freelancer_form'})}});
    const loadStates=async()=>{try{const r=await fetch(`${apiBase}/api/public/locations/states`);const rows=await r.json();stateSelect.innerHTML='';stateSelect.append(option('',copy.choose));rows.forEach(x=>stateSelect.append(option(x.code,x.name)))}catch{stateSelect.innerHTML='';stateSelect.append(option('',copy.choose))}};
    const loadCities=async(uf,selectedCity='')=>{citySelect.disabled=true;citySelect.innerHTML='';citySelect.append(option('',copy.loading));if(!uf){citySelect.innerHTML='';citySelect.append(option('',copy.choose));return}try{const r=await fetch(`${apiBase}/api/public/locations/cities/${encodeURIComponent(uf)}`);const rows=await r.json();citySelect.innerHTML='';citySelect.append(option('',copy.choose));rows.forEach(x=>citySelect.append(option(x.name,x.name)));if(selectedCity){const wanted=upper(selectedCity);const match=[...citySelect.options].find(x=>upper(x.value)===wanted);if(match)citySelect.value=match.value}citySelect.disabled=false}catch{citySelect.innerHTML='';citySelect.append(option('',copy.choose))}};
    stateSelect?.addEventListener('change',()=>loadCities(stateSelect.value));
    const lookupCep=async()=>{const cep=digits(cepInput?.value);if(cep.length!==8||cep===lastCep)return;lastCep=cep;setCepStatus(copy.loading);try{const r=await fetch(`${apiBase}/api/public/locations/cep/${cep}`);const result=await r.json().catch(()=>({}));if(!r.ok)throw new Error(result.error||'cep');if(result.state){stateSelect.value=result.state;await loadCities(result.state,result.city||'')}if(result.neighborhood)neighborhoodInput.value=upper(result.neighborhood);if(result.street)streetInput.value=upper(result.street);if(result.complement&&!complementInput.value)complementInput.value=upper(result.complement);setCepStatus(copy.cepFound,'success');numberInput?.focus()}catch{setCepStatus(copy.cepNotFound,'error')}};
    cepInput?.addEventListener('blur',lookupCep);cepInput?.addEventListener('input',()=>{if(digits(cepInput.value).length===8)window.setTimeout(lookupCep,80);else{lastCep='';setCepStatus('')}});
    form?.querySelectorAll('input[name="roles"]').forEach(input=>input.addEventListener('change',()=>{const selected=[...form.querySelectorAll('input[name="roles"]:checked')].map(x=>upper(x.value));const custom=selected.includes('OUTROS');otherWrap.hidden=!custom;otherInput.required=custom;if(!custom)otherInput.value=''}));loadStates();
    const signalUnderage=async(cpf,birthDate)=>{if(!validCpf(cpf)||!birthDate)return;try{const fd=new FormData();fd.set('cpf',digits(cpf));fd.set('birthDate',birthDate);await fetch(`${apiBase}/api/public/freelancers`,{method:'POST',body:fd})}catch{}};
    form?.addEventListener('submit',async e=>{e.preventDefault();setMessage('');const name=form.elements.name.value.trim(),cpf=form.elements.cpf.value,whatsapp=form.elements.whatsapp.value,email=form.elements.email.value.trim(),birthDisplay=form.elements.birthDate.value,birthDate=dateToIso(birthDisplay),age=ageFromIso(birthDate),postalCode=digits(form.elements.postalCode.value),neighborhood=form.elements.neighborhood.value.trim(),street=form.elements.street.value.trim(),addressNumber=form.elements.addressNumber.value.trim(),complement=form.elements.complement.value.trim(),availability=form.elements.availability.value.trim(),selectedRoles=[...form.querySelectorAll('input[name="roles"]:checked')];
      if(age>=0&&age<18){signalUnderage(cpf,birthDate);openModal([],{age:true});return}
      const errors=[];if(/\d/.test(name)||name.length<5)errors.push(es?'EL NOMBRE COMPLETO NO PUEDE CONTENER NÚMEROS.':'NOME COMPLETO NÃO PODE CONTER NÚMEROS.');if(!validCpf(cpf))errors.push(es?'INFORMA UN CPF VÁLIDO.':'INFORME UM CPF VÁLIDO.');if(!birthDate)errors.push(es?'INFORMA UNA FECHA DE NACIMIENTO VÁLIDA EN DD/MM/AAAA.':'INFORME UMA DATA DE NASCIMENTO VÁLIDA NO FORMATO DD/MM/AAAA.');else if(age>109||age<0)errors.push(es?'REVISA LA FECHA DE NACIMIENTO.':'REVISE A DATA DE NASCIMENTO.');if(digits(whatsapp).length!==11)errors.push(es?'WHATSAPP DEBE TENER DDD Y 9 DÍGITOS.':'WHATSAPP DEVE TER DDD E 9 DÍGITOS, EX.: 81 90000-0000.');if(!validEmail(email))errors.push(es?'INFORMA UN E-MAIL VÁLIDO.':'INFORME UM E-MAIL VÁLIDO.');if(postalCode&&postalCode.length!==8)errors.push(es?'REVISA EL CEP INFORMADO.':'REVISE O CEP INFORMADO.');if(!stateSelect.value)errors.push(es?'SELECCIONA EL ESTADO.':'SELECIONE O ESTADO.');if(!citySelect.value)errors.push(es?'SELECCIONA LA CIUDAD.':'SELECIONE A CIDADE.');if(!neighborhood)errors.push(es?'INFORMA EL BARRIO.':'INFORME O BAIRRO.');if(!street)errors.push(es?'INFORMA LA CALLE / DIRECCIÓN.':'INFORME A RUA / LOGRADOURO.');if(!addressNumber)errors.push(es?'INFORMA EL NÚMERO.':'INFORME O NÚMERO.');if(!selectedRoles.length)errors.push(es?'SELECCIONA AL MENOS UNA FUNCIÓN.':'SELECIONE PELO MENOS UMA FUNÇÃO.');if(otherInput.required&&!otherInput.value.trim())errors.push(es?'DESCRIBE LA FUNCIÓN “OTROS”.':'DESCREVA A FUNÇÃO “OUTROS”.');if(availability.length>availabilityLimit)errors.push(es?`LAS OBSERVACIONES DEBEN TENER COMO MÁXIMO ${availabilityLimit} CARACTERES.`:`AS OBSERVAÇÕES DEVEM TER NO MÁXIMO ${availabilityLimit} CARACTERES.`);if(!privacyInput?.checked)errors.push(copy.privacyError);const resume=form.elements.resume.files?.[0];if(resume&&resume.type!=='application/pdf')errors.push(es?'EL CURRÍCULO DEBE SER PDF.':'O CURRÍCULO DEVE SER UM ARQUIVO PDF.');if(resume&&resume.size>5*1024*1024)errors.push(es?'EL CURRÍCULO DEBE TENER HASTA 5 MB.':'O CURRÍCULO DEVE TER NO MÁXIMO 5 MB.');if(form.elements.portfolioUrl.value&&!form.elements.portfolioUrl.validity.valid)errors.push(es?'REVISA LA URL DEL PORTAFOLIO.':'REVISE O LINK DO PORTFÓLIO.');if(errors.length){openModal(errors);return}
