---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getHomePage } from '@/lib/cms';
import type { Locale } from '@/lib/cms';
const locale: Locale = Astro.url.searchParams.get('lang') === 'es' ? 'es' : 'pt-BR';
const es=locale==='es';
const site=await getHomePage();
const c=es?{
  eyebrow:'PRIVACIDAD · BANCO DE PROFESIONALES',title:'CÓMO GTRZ TRATA TUS DATOS.',intro:'Este aviso explica cómo se utilizan los datos enviados en el formulario de trabajo de GTRZ.',controller:'RESPONSABLE DEL TRATAMIENTO',controllerText:'GTRZ es responsable del tratamiento de los datos personales recibidos a través del formulario de candidatos y de la administración de su base de profesionales.',purpose:'FINALIDADES',purposeText:'Los datos se utilizan para registrar y analizar candidaturas, mantener una base de profesionales, contactar personas para futuras oportunidades, formar equipos de producción, formalizar contrataciones y gestionar la prestación de servicios.',cpf:'USO DEL CPF',cpfText:'El CPF se solicita para validar la consistencia del registro, individualizar correctamente la candidatura, evitar duplicidades y, si existe contratación, permitir la identificación necesaria para formalizar contratos y cumplir los procedimientos relacionados con la prestación de servicios.',retention:'CONSERVACIÓN',retentionText:'Los datos podrán conservarse mientras sean pertinentes y necesarios para las finalidades de reclutamiento, base de profesionales, contratación y gestión de servicios, además de las hipótesis de conservación permitidas o exigidas por la legislación aplicable.',sharing:'COMPARTICIÓN Y USO COMERCIAL',sharingText:'GTRZ no vende datos personales, no los utiliza para publicidad de terceros y no realiza comparticiones incompatibles con las finalidades informadas. El acceso se limita a personas y proveedores que necesiten los datos para actividades relacionadas con reclutamiento, contratación, producción y cumplimiento de obligaciones.',rights:'DERECHOS DEL TITULAR',rightsText:'El titular puede solicitar, según la legislación aplicable, confirmación del tratamiento, acceso, corrección y demás derechos previstos en la normativa de protección de datos. La eliminación podrá estar sujeta a hipótesis legales de conservación.',record:'REGISTRO DEL AVISO',recordText:'Al enviar la candidatura, el sistema registra la aceptación, la fecha y hora, el idioma y la versión del aviso presentado. También se conserva una copia del texto correspondiente a esa versión para fines de auditoría y prueba de transparencia.',version:'VERSIÓN 1.0'
}:{
  eyebrow:'PRIVACIDADE · BANCO DE PROFISSIONAIS',title:'COMO A GTRZ TRATA SEUS DADOS.',intro:'Este aviso explica como são utilizados os dados enviados no formulário Trabalhe Conosco da GTRZ.',controller:'CONTROLADOR DOS DADOS',controllerText:'A GTRZ é responsável pelo tratamento dos dados pessoais recebidos por meio do formulário de candidaturas e pela administração do seu banco de profissionais.',purpose:'FINALIDADES',purposeText:'Os dados são utilizados para registrar e analisar candidaturas, manter banco de profissionais, entrar em contato para futuras oportunidades, formar equipes de produção, formalizar contratações e administrar a prestação de serviços.',cpf:'USO DO CPF',cpfText:'O CPF é solicitado para validar a consistência do cadastro, individualizar corretamente a candidatura, evitar duplicidades e, caso haja contratação, permitir a identificação necessária à formalização de contratos e aos procedimentos relacionados à prestação de serviços.',retention:'CONSERVAÇÃO',retentionText:'Os dados poderão ser conservados enquanto forem pertinentes e necessários às finalidades de recrutamento, banco de profissionais, contratação e gestão de serviços, além das hipóteses de conservação permitidas ou exigidas pela legislação aplicável.',sharing:'COMPARTILHAMENTO E USO COMERCIAL',sharingText:'A GTRZ não vende dados pessoais, não os utiliza para publicidade de terceiros e não realiza compartilhamentos incompatíveis com as finalidades informadas. O acesso é limitado às pessoas e prestadores que necessitem dos dados para atividades relacionadas a recrutamento, contratação, produção e cumprimento de obrigações.',rights:'DIREITOS DO TITULAR',rightsText:'O titular poderá solicitar, nos termos da legislação aplicável, confirmação do tratamento, acesso, correção e os demais direitos previstos na legislação de proteção de dados. A eliminação poderá estar sujeita às hipóteses legais de conservação.',record:'REGISTRO DO AVISO',recordText:'Ao enviar a candidatura, o sistema registra o aceite, a data e hora, o idioma e a versão do aviso apresentado. Também é conservada uma cópia do texto correspondente àquela versão para fins de auditoria e comprovação de transparência.',version:'VERSÃO 1.0'
};
---
<SiteLayout locale={locale} title={es?'Privacidad de profesionales · GTRZ':'Privacidade de profissionais · GTRZ'} settings={site.settings}>
  <main class="privacy-page">
    <section class="privacy-hero"><div class="shell"><span class="eyebrow">{c.eyebrow}</span><h1>{c.title}</h1><p>{c.intro}</p><small>{c.version}</small></div></section>
    <section class="privacy-content"><div class="shell privacy-grid">
      <article><h2>{c.controller}</h2><p>{c.controllerText}</p></article>
      <article><h2>{c.purpose}</h2><p>{c.purposeText}</p></article>
      <article><h2>{c.cpf}</h2><p>{c.cpfText}</p></article>
      <article><h2>{c.retention}</h2><p>{c.retentionText}</p></article>
      <article><h2>{c.sharing}</h2><p>{c.sharingText}</p></article>
      <article><h2>{c.rights}</h2><p>{c.rightsText}</p></article>
      <article><h2>{c.record}</h2><p>{c.recordText}</p></article>
    </div></section>
  </main>
</SiteLayout>
<style>
.privacy-page{background:#090909;color:#f4f0ec;min-height:100vh}.privacy-hero{padding:150px 0 70px;border-bottom:1px solid #242424;background:radial-gradient(70% 100% at 100% 0%,rgba(255,33,24,.14),transparent 60%),#090909}.privacy-hero h1{font-size:clamp(3.3rem,8vw,7.5rem);line-height:.86;max-width:920px;margin:18px 0 24px}.privacy-hero p{max-width:680px;color:#aaa39e;font-size:1.05rem;line-height:1.7}.privacy-hero small{display:inline-block;margin-top:20px;color:#ff3128;font-weight:900;letter-spacing:.12em}.privacy-content{padding:70px 0 110px}.privacy-grid{max-width:980px;display:grid;gap:16px}.privacy-grid article{padding:26px;border:1px solid #2a2a2a;border-radius:22px;background:#101010}.privacy-grid h2{margin:0 0 12px;font-size:.82rem;letter-spacing:.12em;color:#fff}.privacy-grid p{margin:0;color:#aaa39e;line-height:1.8;font-size:.95rem}@media(max-width:700px){.privacy-hero{padding:110px 0 48px}.privacy-content{padding:36px 0 80px}.privacy-grid article{padding:20px;border-radius:18px}}
</style>