---
import SiteLayout from '@/layouts/SiteLayout.astro';
import HubLayout from '@/layouts/HubLayout.astro';
import EventPopup from '@/components/EventPopup.astro';
import EventHub from '@/components/EventHub.astro';
import SectionRenderer from '@/components/SectionRenderer.astro';
import {getHomePage,pickLocale,localizedSections} from '@/lib/cms';
import type {Locale} from '@/lib/cms';

const requested=Astro.url.searchParams.get('lang');
const locale:Locale=requested==='es'?'es':'pt-BR';
const payload=await getHomePage();
const events=pickLocale(payload.events,locale);
const team=pickLocale(payload.team,locale);
const sections=localizedSections(payload.sections,locale);
const homepageMode=payload.settings.general?.homepageMode==='full'?'full':'hub';
const apiBase=import.meta.env.PUBLIC_API_BASE||'';
const activeHubEvent=events.find(event=>['published','sales_open','sold_out'].includes(event.status));
let hubSocialMediaId=activeHubEvent?.hero_media_id||null;
if(!hubSocialMediaId&&activeHubEvent?.theme_json){
  try{
    const theme=JSON.parse(activeHubEvent.theme_json);
    hubSocialMediaId=theme.hubCardMediaId||theme.hub_card_media_id||theme.posterMediaId||theme.poster_media_id||null;
  }catch{}
}
const hubOgImage=hubSocialMediaId?`${apiBase}/api/media/${encodeURIComponent(hubSocialMediaId)}`:'';
const canonicalPtUrl=new URL('/',Astro.url.origin).toString();
const canonicalEsUrl=new URL('/?lang=es',Astro.url.origin).toString();
const instagram=typeof payload.settings.social?.instagram==='string'
  ?String(payload.settings.social.instagram)
  :typeof payload.settings.social?.instagramUrl==='string'
    ?String(payload.settings.social.instagramUrl)
    :'https://www.instagram.com/gtrzeventos/';
const organizationId='https://gtrz.com.br/#organization';
const websiteId='https://gtrz.com.br/#website';
const siteSchema={
  '@context':'https://schema.org',
  '@graph':[
    {
      '@type':'Organization',
      '@id':organizationId,
      name:payload.settings.general?.siteName||'GTRZ Eventos',
      url:'https://gtrz.com.br/',
      logo:'https://gtrz.com.br/brand/gtrz-wordmark.svg',
      sameAs:[instagram]
    },
    {
      '@type':'WebSite',
      '@id':websiteId,
      url:'https://gtrz.com.br/',
      name:payload.settings.general?.siteName||'GTRZ Eventos',
      publisher:{'@id':organizationId},
      inLanguage:['pt-BR','es']
    }
  ]
};
---
{homepageMode==='full' ? (
  <SiteLayout
    locale={locale}
    settings={payload.settings}
    canonicalUrl={locale==='es'?canonicalEsUrl:canonicalPtUrl}
    alternatePtUrl={canonicalPtUrl}
    alternateEsUrl={canonicalEsUrl}
  >
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>
    <main>{sections.map(section=><SectionRenderer section={section} locale={locale} events={events} team={team}/>)}</main>
    <EventPopup events={events} locale={locale} siteSettings={payload.settings}/>
  </SiteLayout>
) : (
  <HubLayout locale={locale} ogImage={hubOgImage}>
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)}></script>
    <EventHub events={events} locale={locale} siteSettings={payload.settings}/>
  </HubLayout>
)}
