---
import SiteLayout from '@/layouts/SiteLayout.astro';
import Turnstile from '@/components/Turnstile.astro';
import { getHomePage } from '@/lib/cms';
import type { Locale } from '@/lib/cms';

const locale: Locale = Astro.url.searchParams.get('lang') === 'es' ? 'es' : 'pt-BR';
const es = locale === 'es';
const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const site = await getHomePage();
const partnershipConfig = (site.settings as any)?.partnership || {};
const defaultPartnerTypes=['LOCAL / CASA / BAR / BOATE','MARCA','EMPRESA','FORNECEDOR','PRODUTORA / PROJETO','ARTISTA / AGÊNCIA','IMPRENSA / MÍDIA','OUTRO'];
const defaultProposalTypes=['PATROCÍNIO','APOIO','LOCAÇÃO DE ESPAÇO','REALIZAÇÃO DE EVENTO','CO-PRODUÇÃO','FORNECIMENTO DE PRODUTO','FORNECIMENTO DE SERVIÇO','AÇÃO DE MARCA','DIVULGAÇÃO / MÍDIA','PERMUTA','CONTRATAÇÃO DA GTRZ','OUTRO'];
const partnerTypes=Array.isArray(partnershipConfig.partnerTypes)&&partnershipConfig.partnerTypes.length?partnershipConfig.partnerTypes:defaultPartnerTypes;
const proposalTypes=Array.isArray(partnershipConfig.proposalTypes)&&partnershipConfig.proposalTypes.length?partnershipConfig.proposalTypes:defaultProposalTypes;
const privacyNoticeVersion='1.0';
const copy=es?{
  eyebrow:'GTRZ · ALIANZAS',title:'CONSTRUYAMOS JUNTOS.',intro:'Registra una oportunidad comercial con GTRZ. El formulario se adapta a tu perfil y muestra solamente lo necesario.',
  steps:['PERFIL','CONTACTO','ORGANIZACIÓN','PROPUESTA','FINALIZAR'],
  partner:'¿QUIÉN ESTÁ HABLANDO CON GTRZ?',partnerHelp:'SELECCIONA EL PERFIL QUE MEJOR REPRESENTA ESTA PROPUESTA.',contact:'RESPONSABLE DEL CONTACTO',organization:'ORGANIZACIÓN / OPERACIÓN',proposal:'LA PROPUESTA',finalize:'FINALIZAR',materials:'MATERIALES COMPLEMENTARIOS',privacy:'PRIVACIDAD Y DATOS',
  tradeName:'NOMBRE DE LA ORGANIZACIÓN / PROYECTO',legalName:'RAZÓN SOCIAL · OPCIONAL',taxId:'CNPJ / CPF · OPCIONAL',segment:'SEGMENTO / ÁREA',website:'SITIO WEB · OPCIONAL',instagram:'INSTAGRAM · OPCIONAL',capacity:'CAPACIDAD DEL ESPACIO · OPCIONAL',serviceType:'TIPO DE SERVICIO',serviceArea:'ÁREA DE ACTUACIÓN',
  name:'NOMBRE COMPLETO',role:'CARGO / FUNCIÓN',whatsapp:'WHATSAPP',email:'E-MAIL',cep:'CEP',state:'ESTADO',city:'CIUDAD',neighborhood:'BARRIO',street:'CALLE / DIRECCIÓN',number:'NÚMERO',complement:'COMPLEMENTO · OPCIONAL',cepHint:'INFORMA EL CEP Y COMPLETAMOS AUTOMÁTICAMENTE LA MAYOR PARTE DE LA DIRECCIÓN.',
  proposalTypes:'TIPOS DE ALIANZA',proposalHelp:'PUEDES MARCAR MÁS DE UNA OPCIÓN.',otherProposal:'DESCRIBE EL OTRO TIPO DE ALIANZA',proposalTitle:'TÍTULO DE LA PROPUESTA',summary:'RESUME LA IDEA',offer:'¿QUÉ OFRECES?',expect:'¿QUÉ ESPERAS DE GTRZ?',investment:'¿EXISTE INVERSIÓN FINANCIERA?',value:'VALOR ESTIMADO · OPCIONAL',period:'INFORMAR FECHA O PERÍODO',start:'INICIO',end:'FIN',
  pdf:'PRESENTACIÓN / MEDIA KIT / PROPUESTA EN PDF · OPCIONAL',link:'LINK DE PRESENTACIÓN · OPCIONAL',observations:'OBSERVACIONES · OPCIONAL',
  privacyText:'Usaremos estos datos para analizar la propuesta, contactar al responsable, conducir negociaciones y mantener el historial de la relación comercial. GTRZ no comercializa estos datos ni los utiliza para finalidades incompatibles.',privacyCheck:'DECLARO QUE LEÍ Y COMPRENDÍ EL AVISO DE PRIVACIDAD Y AUTORIZO EL TRATAMIENTO DE LOS DATOS INFORMADOS PARA ANÁLISIS Y CONTACTO SOBRE ESTA PROPUESTA.',privacyLink:'LEER AVISO COMPLETO',
  back:'VOLVER',next:'CONTINUAR',submit:'REGISTRAR PROPUESTA Y CONTINUAR EN WHATSAPP',choose:'SELECCIONA',loading:'CARGANDO…',cepFound:'DIRECCIÓN ENCONTRADA. REVISA LOS DATOS.',cepNotFound:'NO FUE POSIBLE LOCALIZAR ESTE CEP. COMPLETA LA DIRECCIÓN MANUALMENTE.',errorTitle:'REVISA ESTA ETAPA',errorIntro:'CORRIGE LOS SIGUIENTES PUNTOS ANTES DE CONTINUAR:',close:'ENTENDIDO',success:'PROPUESTA REGISTRADA. ABRIENDO WHATSAPP…',summaryTitle:'TU PROPUESTA',summaryEmpty:'A MEDIDA QUE AVANCES, VERÁS AQUÍ UN RESUMEN.',summaryPartner:'PERFIL',summaryOrg:'ORGANIZACIÓN',summaryCity:'CIUDAD',summaryTypes:'ALIANZA'
}:{
  eyebrow:'GTRZ · PARCERIAS',title:'VAMOS CONSTRUIR JUNTOS.',intro:'Cadastre uma oportunidade comercial com a GTRZ. O formulário se adapta ao seu perfil e mostra apenas o que realmente importa.',
  steps:['PERFIL','CONTATO','ORGANIZAÇÃO','PROPOSTA','FINALIZAR'],
  partner:'QUEM ESTÁ FALANDO COM A GTRZ?',partnerHelp:'SELECIONE O PERFIL QUE MELHOR REPRESENTA ESTA PROPOSTA.',contact:'RESPONSÁVEL PELO CONTATO',organization:'ORGANIZAÇÃO / OPERAÇÃO',proposal:'A PROPOSTA',finalize:'FINALIZAR',materials:'MATERIAIS COMPLEMENTARES',privacy:'PRIVACIDADE E DADOS',
  tradeName:'NOME DA ORGANIZAÇÃO / PROJETO',legalName:'RAZÃO SOCIAL · OPCIONAL',taxId:'CNPJ / CPF · OPCIONAL',segment:'SEGMENTO / ÁREA',website:'SITE · OPCIONAL',instagram:'INSTAGRAM · OPCIONAL',capacity:'CAPACIDADE DO LOCAL · OPCIONAL',serviceType:'TIPO DE SERVIÇO',serviceArea:'ÁREA DE ATUAÇÃO',
  name:'NOME COMPLETO',role:'CARGO / FUNÇÃO',whatsapp:'WHATSAPP',email:'E-MAIL',cep:'CEP',state:'ESTADO',city:'CIDADE',neighborhood:'BAIRRO',street:'RUA / LOGRADOURO',number:'NÚMERO',complement:'COMPLEMENTO · OPCIONAL',cepHint:'INFORME O CEP E PREENCHEREMOS AUTOMATICAMENTE A MAIOR PARTE DO ENDEREÇO.',
  proposalTypes:'TIPOS DE PARCERIA',proposalHelp:'VOCÊ PODE MARCAR MAIS DE UMA OPÇÃO.',otherProposal:'DESCREVA O OUTRO TIPO DE PARCERIA',proposalTitle:'TÍTULO DA PROPOSTA',summary:'RESUMA A IDEIA',offer:'O QUE VOCÊ OFERECE?',expect:'O QUE ESPERA DA GTRZ?',investment:'EXISTE INVESTIMENTO FINANCEIRO?',value:'VALOR ESTIMADO · OPCIONAL',period:'INFORMAR DATA OU PERÍODO',start:'INÍCIO',end:'FIM',
  pdf:'APRESENTAÇÃO / MÍDIA KIT / PROPOSTA EM PDF · OPCIONAL',link:'LINK DE APRESENTAÇÃO · OPCIONAL',observations:'OBSERVAÇÕES · OPCIONAL',
  privacyText:'Usaremos estes dados para analisar a proposta, contatar o responsável, conduzir negociações e manter o histórico do relacionamento comercial. A GTRZ não comercializa estes dados nem os utiliza para finalidades incompatíveis.',privacyCheck:'DECLARO QUE LI E COMPREENDI O AVISO DE PRIVACIDADE E AUTORIZO O TRATAMENTO DOS DADOS INFORMADOS PARA ANÁLISE E CONTATO SOBRE ESTA PROPOSTA.',privacyLink:'LER AVISO COMPLETO',
  back:'VOLTAR',next:'CONTINUAR',submit:'CADASTRAR PROPOSTA E CONTINUAR NO WHATSAPP',choose:'SELECIONE',loading:'CARREGANDO…',cepFound:'ENDEREÇO ENCONTRADO. CONFIRA OS DADOS.',cepNotFound:'NÃO FOI POSSÍVEL LOCALIZAR ESTE CEP. PREENCHA O ENDEREÇO MANUALMENTE.',errorTitle:'REVISE ESTA ETAPA',errorIntro:'CORRIJA OS ITENS ABAIXO ANTES DE CONTINUAR:',close:'ENTENDI',success:'PROPOSTA CADASTRADA. ABRINDO O WHATSAPP…',summaryTitle:'SUA PROPOSTA',summaryEmpty:'CONFORME VOCÊ AVANÇAR, O RESUMO APARECE AQUI.',summaryPartner:'PERFIL',summaryOrg:'ORGANIZAÇÃO',summaryCity:'CIDADE',summaryTypes:'PARCERIA'
};
---
<SiteLayout locale={locale} title={es?'Alianzas · GTRZ':'Parcerias · GTRZ'} settings={site.settings}>
<main class="partner-page">
  <section class="partner-hero"><div class="shell hero-grid"><div><span class="eyebrow">{copy.eyebrow}</span><h1>{copy.title}</h1></div><p>{copy.intro}</p></div></section>
  <section class="partner-form-section"><div class="shell partner-shell">
    <nav class="progress-nav" aria-label="Progresso do formulário">{copy.steps.map((label:string,i:number)=><button type="button" data-step-jump={i} class={i===0?'active':''}><b>{String(i+1).padStart(2,'0')}</b><span>{label}</span></button>)}</nav>
    <div class="form-layout">
      <form data-public-form="partnerships" novalidate>
        <section class="step-panel active" data-step="0"><header><span>01</span><div><h2>{copy.partner}</h2><p>{copy.partnerHelp}</p></div></header><div class="choice-grid partner-choice-grid">{partnerTypes.map((type:string)=><label class="choice"><input type="radio" name="partnerType" value={String(type).toLocaleUpperCase('pt-BR')} /><span>{String(type).toLocaleUpperCase('pt-BR')}</span></label>)}</div></section>

        <section class="step-panel" data-step="1" hidden><header><span>02</span><div><h2>{copy.contact}</h2><p>{es?'QUIÉN SERÁ NUESTRO PUNTO DE CONTACTO.':'QUEM SERÁ NOSSO PONTO DE CONTATO.'}</p></div></header><div class="form-grid"><label><span>{copy.name} *</span><input name="contactName" required maxlength="160" data-person-name data-upper autocomplete="name" /></label><label><span>{copy.role} *</span><input name="contactRole" required maxlength="120" data-upper /></label><label><span>{copy.whatsapp} *</span><input name="whatsapp" required inputmode="tel" maxlength="13" placeholder="81 90000-0000" data-phone autocomplete="tel" /></label><label><span>{copy.email} *</span><input name="email" type="email" required maxlength="200" placeholder="NOME@EMAIL.COM" autocomplete="email" /></label></div></section>

        <section class="step-panel" data-step="2" hidden><header><span>03</span><div><h2>{copy.organization}</h2><p>{es?'LOS CAMPOS CAMBIAN SEGÚN EL PERFIL SELECCIONADO.':'OS CAMPOS SE ADAPTAM AO PERFIL SELECIONADO.'}</p></div></header><div class="form-grid"><label><span>{copy.tradeName} *</span><input name="tradeName" required maxlength="180" data-upper /></label><label><span>{copy.legalName}</span><input name="legalName" maxlength="200" data-upper /></label><label><span>{copy.taxId}</span><input name="taxId" inputmode="numeric" maxlength="18" data-tax-id placeholder="00.000.000/0000-00" /></label><label><span>{copy.segment} *</span><input name="segment" required maxlength="120" data-upper /></label><label><span>{copy.website}</span><input name="websiteUrl" type="url" maxlength="1000" placeholder="HTTPS://" /></label><label><span>{copy.instagram}</span><input name="instagramUrl" maxlength="200" placeholder="@" /></label><label class="conditional local-only" hidden><span>{copy.capacity}</span><input name="venueCapacity" inputmode="numeric" maxlength="7" /></label><label class="conditional supplier-only" hidden><span>{copy.serviceType} *</span><input name="serviceType" maxlength="160" data-upper /></label><label class="conditional supplier-only" hidden><span>{copy.serviceArea} *</span><input name="serviceArea" maxlength="160" data-upper /></label></div><div class="location-shell"><p class="address-help">{copy.cepHint}</p><div class="form-grid three"><label class="conditional local-only" hidden><span>{copy.cep} *</span><input name="postalCode" inputmode="numeric" maxlength="9" placeholder="00000-000" data-cep autocomplete="postal-code" /></label><label><span>{copy.state} *</span><select name="state" required data-state><option value="">{copy.loading}</option></select></label><label><span>{copy.city} *</span><select name="city" required data-city disabled><option value="">{copy.choose}</option></select></label><label class="conditional local-only" hidden><span>{copy.neighborhood} *</span><input name="neighborhood" maxlength="120" data-upper /></label><label class="conditional local-only span-two" hidden><span>{copy.street} *</span><input name="street" maxlength="180" data-upper /></label><label class="conditional local-only" hidden><span>{copy.number} *</span><input name="addressNumber" maxlength="30" data-upper /></label><label class="conditional local-only span-two" hidden><span>{copy.complement}</span><input name="complement" maxlength="160" data-upper /></label></div><p class="cep-status" data-cep-status aria-live="polite"></p></div></section>

        <section class="step-panel" data-step="3" hidden><header><span>04</span><div><h2>{copy.proposal}</h2><p>{copy.proposalHelp}</p></div></header><div class="choice-grid proposal-choice-grid">{proposalTypes.map((type:string)=><label class="choice chip"><input type="checkbox" name="proposalTypes" value={String(type).toLocaleUpperCase('pt-BR')} /><span>{String(type).toLocaleUpperCase('pt-BR')}</span></label>)}</div><label class="other-proposal" hidden data-other-proposal><span>{copy.otherProposal} *</span><input name="otherProposalType" maxlength="180" data-upper /></label><div class="form-grid proposal-fields"><label class="wide"><span>{copy.proposalTitle} *</span><input name="proposalTitle" required maxlength="180" data-upper /></label><label class="wide"><span>{copy.summary} *</span><textarea name="message" required maxlength="1200" rows="4" data-upper></textarea></label><label><span>{copy.offer} *</span><textarea name="offerText" required maxlength="1200" rows="4" data-upper></textarea></label><label><span>{copy.expect} *</span><textarea name="expectationText" required maxlength="1200" rows="4" data-upper></textarea></label></div><div class="optional-row"><label><span>{copy.investment}</span><select name="investmentStatus" required><option value="">{copy.choose}</option><option value="SIM">SIM</option><option value="NÃO">NÃO</option><option value="A DEFINIR">A DEFINIR</option></select></label><label class="investment-value" hidden><span>{copy.value}</span><input name="investmentValue" inputmode="decimal" maxlength="20" placeholder="R$ 0,00" /></label><label class="period-toggle"><input type="checkbox" data-period-toggle /><span>{copy.period}</span></label></div><div class="form-grid period-fields" hidden><label><span>{copy.start}</span><input name="startsAt" type="date" /></label><label><span>{copy.end}</span><input name="endsAt" type="date" /></label></div></section>

        <section class="step-panel" data-step="4" hidden><header><span>05</span><div><h2>{copy.finalize}</h2><p>{es?'MATERIALES OPCIONALES, OBSERVACIONES Y PRIVACIDAD.':'MATERIAIS OPCIONAIS, OBSERVAÇÕES E PRIVACIDADE.'}</p></div></header><details class="compact-details"><summary>{copy.materials}</summary><div class="form-grid details-grid"><label class="file-field"><span>{copy.pdf}</span><input name="proposalFile" type="file" accept="application/pdf,.pdf" /><small>PDF · MÁX. 10 MB</small></label><label><span>{copy.link}</span><input name="presentationUrl" type="url" maxlength="1000" placeholder="HTTPS://" /></label><label class="wide observation-wrap"><span>{copy.observations}</span><textarea name="observations" maxlength="1000" rows="4" data-upper data-observations></textarea><small class="char-count"><b data-observation-count>0</b> / 1000</small></label></div></details><div class="privacy-card"><span class="privacy-kicker">{copy.privacy}</span><p>{copy.privacyText}</p><a href={`/privacidade-parcerias?lang=${es?'es':'pt-BR'}`} target="_blank" rel="noreferrer">{copy.privacyLink}</a><label class="privacy-consent"><input type="checkbox" name="privacyAccepted" value="1" data-privacy-consent /><span>{copy.privacyCheck}</span></label><input type="hidden" name="privacyNoticeVersion" value={privacyNoticeVersion}/><input type="hidden" name="privacyNoticeLocale" value={es?'es':'pt-BR'}/></div><Turnstile action="partnership" /><p data-form-message class="form-message" aria-live="polite"></p></section>

        <div class="step-actions"><button type="button" class="button ghost" data-prev>{copy.back}</button><div class="step-meta"><span data-step-counter>01 / 05</span><div class="step-bar"><i data-step-bar></i></div></div><button type="button" class="button primary" data-next>{copy.next}</button><button type="submit" class="button primary submit-final" data-submit hidden>{copy.submit}</button></div>
      </form>

      <aside class="proposal-summary"><span class="summary-kicker">{copy.summaryTitle}</span><p class="summary-empty" data-summary-empty>{copy.summaryEmpty}</p><dl><div data-summary-row="partner" hidden><dt>{copy.summaryPartner}</dt><dd data-summary-partner></dd></div><div data-summary-row="org" hidden><dt>{copy.summaryOrg}</dt><dd data-summary-org></dd></div><div data-summary-row="city" hidden><dt>{copy.summaryCity}</dt><dd data-summary-city></dd></div><div data-summary-row="types" hidden><dt>{copy.summaryTypes}</dt><dd data-summary-types></dd></div></dl></aside>
    </div>
  </div></section>
</main>
<div class="form-modal" hidden data-error-modal role="dialog" aria-modal="true"><button class="form-modal-backdrop" type="button" aria-label={copy.close} data-modal-close></button><div class="form-modal-card"><div class="form-modal-mark">!</div><h2>{copy.errorTitle}</h2><p>{copy.errorIntro}</p><ul data-modal-errors></ul><button class="button primary" type="button" data-modal-close>{copy.close}</button></div></div>
<script is:inline define:vars={{apiBase,copy,es,privacyNoticeVersion}}>
const form=document.querySelector('[data-public-form="partnerships"]');const panels=[...form.querySelectorAll('[data-step]')];const jumps=[...document.querySelectorAll('[data-step-jump]')];const prevBtn=form.querySelector('[data-prev]');const nextBtn=form.querySelector('[data-next]');const submitBtn=form.querySelector('[data-submit]');const counter=form.querySelector('[data-step-counter]');const bar=form.querySelector('[data-step-bar]');const msg=form.querySelector('[data-form-message]');const stateSelect=form.querySelector('[data-state]');const citySelect=form.querySelector('[data-city]');const cepInput=form.querySelector('[data-cep]');const cepStatus=form.querySelector('[data-cep-status]');const nameInput=form.querySelector('[data-person-name]');const phoneInput=form.querySelector('[data-phone]');const taxInput=form.querySelector('[data-tax-id]');const obs=form.querySelector('[data-observations]');const obsCount=form.querySelector('[data-observation-count]');const otherWrap=form.querySelector('[data-other-proposal]');const otherInput=form.querySelector('[name="otherProposalType"]');const investment=form.querySelector('[name="investmentStatus"]');const investmentWrap=form.querySelector('.investment-value');const periodToggle=form.querySelector('[data-period-toggle]');const periodFields=form.querySelector('.period-fields');const modal=document.querySelector('[data-error-modal]');const modalErrors=modal.querySelector('[data-modal-errors]');let currentStep=0,lastCep='';
const upper=v=>String(v||'').toLocaleUpperCase('pt-BR');const digits=v=>String(v||'').replace(/\D/g,'');const option=(v,l)=>{const o=document.createElement('option');o.value=v;o.textContent=l;return o};const formatPhone=v=>{const d=digits(v).slice(0,11);if(d.length<=2)return d;if(d.length<=7)return `${d.slice(0,2)} ${d.slice(2)}`;return `${d.slice(0,2)} ${d.slice(2,7)}-${d.slice(7)}`};const formatCep=v=>{const d=digits(v).slice(0,8);return d.length<=5?d:`${d.slice(0,5)}-${d.slice(5)}`};const formatTax=v=>{const d=digits(v).slice(0,14);if(d.length<=11)return d.replace(/^(\d{3})(\d)/,'$1.$2').replace(/^(\d{3})\.(\d{3})(\d)/,'$1.$2.$3').replace(/\.(\d{3})(\d)/,'.$1-$2');return d.replace(/^(\d{2})(\d)/,'$1.$2').replace(/^(\d{2})\.(\d{3})(\d)/,'$1.$2.$3').replace(/\.(\d{3})(\d)/,'.$1/$2').replace(/(\/\d{4})(\d)/,'$1-$2')};const validEmail=v=>/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/i.test(String(v||'').trim());
const validCpf=raw=>{const cpf=digits(raw);if(cpf.length!==11||/^(\d)\1{10}$/.test(cpf))return false;const calc=len=>{let sum=0;for(let i=0;i<len;i++)sum+=Number(cpf[i])*(len+1-i);const r=(sum*10)%11;return r===10?0:r};return calc(9)===Number(cpf[9])&&calc(10)===Number(cpf[10])};const validCnpj=raw=>{const c=digits(raw);if(c.length!==14||/^(\d)\1{13}$/.test(c))return false;const calc=base=>{const w=base===12?[5,4,3,2,9,8,7,6,5,4,3,2]:[6,5,4,3,2,9,8,7,6,5,4,3,2];let s=0;for(let i=0;i<base;i++)s+=Number(c[i])*w[i];const r=s%11;return r<2?0:11-r};return calc(12)===Number(c[12])&&calc(13)===Number(c[13])};
const openModal=errors=>{modalErrors.innerHTML='';errors.forEach(t=>{const li=document.createElement('li');li.textContent=t;modalErrors.append(li)});modal.hidden=false;document.documentElement.style.overflow='hidden'};const closeModal=()=>{modal.hidden=true;document.documentElement.style.overflow=''};modal.querySelectorAll('[data-modal-close]').forEach(x=>x.addEventListener('click',closeModal));
const isLocal=()=>upper(form.elements.partnerType?.value||'').includes('LOCAL / CASA');const isSupplier=()=>upper(form.elements.partnerType?.value||'').includes('FORNECEDOR');
const updateSummary=()=>{const partner=form.elements.partnerType?.value||'';const org=form.elements.tradeName?.value||'';const city=[form.elements.city?.value,form.elements.state?.value].filter(Boolean).join(' · ');const types=[...form.querySelectorAll('input[name="proposalTypes"]:checked')].map(x=>x.value);const values={partner,org,city,types:types.join(' · ')};let any=false;Object.entries(values).forEach(([k,v])=>{const row=document.querySelector(`[data-summary-row="${k}"]`);const out=document.querySelector(`[data-summary-${k}]`);if(v){row.hidden=false;out.textContent=v;any=true}else row.hidden=true});document.querySelector('[data-summary-empty]').hidden=any};
const saveDraft=()=>{try{const data={};for(const [k,v] of new FormData(form).entries()){if(v instanceof File||k==='cf-turnstile-response'||k==='privacyAccepted')continue;if(k==='proposalTypes'){data[k]=data[k]||[];data[k].push(v)}else data[k]=v}localStorage.setItem('gtrz-partnership-draft-v2',JSON.stringify(data))}catch{}};
const restoreDraft=()=>{try{const data=JSON.parse(localStorage.getItem('gtrz-partnership-draft-v2')||'null');if(!data)return;Object.entries(data).forEach(([k,v])=>{if(k==='proposalTypes'&&Array.isArray(v)){form.querySelectorAll('input[name="proposalTypes"]').forEach(x=>x.checked=v.includes(x.value));return}const el=form.elements[k];if(!el)return;if(el instanceof RadioNodeList){[...el].forEach(x=>x.checked=x.value===v)}else el.value=v});syncPartner();syncOther();if(stateSelect.value)loadCities(stateSelect.value,data.city||'');updateSummary()}catch{}};
const showStep=i=>{currentStep=Math.max(0,Math.min(panels.length-1,i));panels.forEach((p,n)=>{p.hidden=n!==currentStep;p.classList.toggle('active',n===currentStep)});jumps.forEach((b,n)=>{b.classList.toggle('active',n===currentStep);b.classList.toggle('done',n<currentStep)});prevBtn.hidden=currentStep===0;nextBtn.hidden=currentStep===panels.length-1;submitBtn.hidden=currentStep!==panels.length-1;counter.textContent=`${String(currentStep+1).padStart(2,'0')} / ${String(panels.length).padStart(2,'0')}`;bar.style.width=`${((currentStep+1)/panels.length)*100}%`;window.scrollTo({top:Math.max(0,document.querySelector('.partner-form-section').offsetTop-80),behavior:'smooth'})};
const errorsForStep=i=>{const fd=new FormData(form),errors=[];if(i===0&&!fd.get('partnerType'))errors.push(es?'SELECCIONA EL TIPO DE SOCIO.':'SELECIONE O TIPO DE PARCEIRO.');if(i===1){const contact=String(fd.get('contactName')||'').trim(),email=String(fd.get('email')||'').trim();if(contact.length<5||/\d/.test(contact))errors.push(es?'INFORMA UN NOMBRE COMPLETO VÁLIDO, SIN NÚMEROS.':'INFORME UM NOME COMPLETO VÁLIDO, SEM NÚMEROS.');if(!fd.get('contactRole'))errors.push(es?'INFORMA EL CARGO O FUNCIÓN DEL RESPONSABLE.':'INFORME O CARGO OU FUNÇÃO DO RESPONSÁVEL.');if(digits(fd.get('whatsapp')).length!==11)errors.push(es?'INFORMA UN WHATSAPP CON DDD Y 9 DÍGITOS.':'INFORME UM WHATSAPP COM DDD E 9 DÍGITOS.');if(!validEmail(email))errors.push(es?'INFORMA UN E-MAIL VÁLIDO.':'INFORME UM E-MAIL VÁLIDO.')}if(i===2){const tax=digits(fd.get('taxId'));if(!fd.get('tradeName'))errors.push(es?'INFORMA EL NOMBRE DE LA ORGANIZACIÓN O PROYECTO.':'INFORME O NOME DA ORGANIZAÇÃO OU PROJETO.');if(!fd.get('segment'))errors.push(es?'INFORMA EL SEGMENTO O ÁREA.':'INFORME O SEGMENTO OU ÁREA.');if(tax&&!(tax.length===11?validCpf(tax):tax.length===14&&validCnpj(tax)))errors.push(es?'REVISA EL CPF / CNPJ INFORMADO.':'REVISE O CPF / CNPJ INFORMADO.');if(!stateSelect.value||!citySelect.value)errors.push(es?'SELECCIONA ESTADO Y CIUDAD.':'SELECIONE ESTADO E CIDADE.');if(isLocal()){if(digits(fd.get('postalCode')).length!==8)errors.push(es?'INFORMA UN CEP VÁLIDO PARA EL ESPACIO.':'INFORME UM CEP VÁLIDO PARA O LOCAL.');if(!fd.get('neighborhood')||!fd.get('street')||!fd.get('addressNumber'))errors.push(es?'COMPLETA BARRIO, DIRECCIÓN Y NÚMERO DEL ESPACIO.':'PREENCHA BAIRRO, RUA E NÚMERO DO LOCAL.')}if(isSupplier()&&(!fd.get('serviceType')||!fd.get('serviceArea')))errors.push(es?'COMPLETA TIPO DE SERVICIO Y ÁREA DE ACTUACIÓN.':'PREENCHA TIPO DE SERVIÇO E ÁREA DE ATUAÇÃO.')}if(i===3){const proposals=fd.getAll('proposalTypes');if(!proposals.length)errors.push(es?'SELECCIONA AL MENOS UN TIPO DE ALIANZA.':'SELECIONE PELO MENOS UM TIPO DE PARCERIA.');if(otherInput.required&&!otherInput.value.trim())errors.push(es?'DESCRIBE EL OTRO TIPO DE ALIANZA.':'DESCREVA O OUTRO TIPO DE PARCERIA.');if(!fd.get('proposalTitle')||!fd.get('message')||!fd.get('offerText')||!fd.get('expectationText')||!fd.get('investmentStatus'))errors.push(es?'COMPLETA LOS CAMPOS OBLIGATORIOS DE LA PROPUESTA.':'PREENCHA OS CAMPOS OBRIGATÓRIOS DA PROPOSTA.')}return [...new Set(errors)]};
prevBtn.addEventListener('click',()=>showStep(currentStep-1));nextBtn.addEventListener('click',()=>{const errors=errorsForStep(currentStep);if(errors.length)return openModal(errors);saveDraft();showStep(currentStep+1)});jumps.forEach((b,i)=>b.addEventListener('click',()=>{if(i<=currentStep)showStep(i)}));
form.querySelectorAll('[data-upper]').forEach(el=>el.addEventListener('input',()=>{el.value=upper(el.value);saveDraft();updateSummary()}));form.querySelectorAll('input,select,textarea').forEach(el=>el.addEventListener('change',()=>{saveDraft();updateSummary()}));nameInput.addEventListener('beforeinput',e=>{if(e.data&&/\d/.test(e.data))e.preventDefault()});nameInput.addEventListener('input',()=>nameInput.value=upper(nameInput.value.replace(/\d/g,'')));phoneInput.addEventListener('input',()=>phoneInput.value=formatPhone(phoneInput.value));cepInput.addEventListener('input',()=>cepInput.value=formatCep(cepInput.value));taxInput.addEventListener('input',()=>taxInput.value=formatTax(taxInput.value));obs.addEventListener('input',()=>{obsCount.textContent=String(obs.value.length)});
const loadStates=async()=>{try{const r=await fetch(`${apiBase}/api/public/locations/states`);const rows=await r.json();const selected=stateSelect.value;stateSelect.innerHTML='';stateSelect.append(option('',copy.choose));rows.forEach(x=>stateSelect.append(option(x.code,x.name)));if(selected)stateSelect.value=selected}catch{stateSelect.innerHTML='';stateSelect.append(option('',copy.choose))}};const loadCities=async(uf,selected='')=>{citySelect.disabled=true;citySelect.innerHTML='';citySelect.append(option('',copy.loading));if(!uf)return;try{const r=await fetch(`${apiBase}/api/public/locations/cities/${encodeURIComponent(uf)}`);const rows=await r.json();citySelect.innerHTML='';citySelect.append(option('',copy.choose));rows.forEach(x=>citySelect.append(option(x.name,x.name)));if(selected){const m=[...citySelect.options].find(x=>upper(x.value)===upper(selected));if(m)citySelect.value=m.value}citySelect.disabled=false;updateSummary()}catch{citySelect.innerHTML='';citySelect.append(option('',copy.choose))}};stateSelect.addEventListener('change',()=>loadCities(stateSelect.value));
