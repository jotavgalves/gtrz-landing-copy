form.addEventListener('submit',async e=>{e.preventDefault();if(msg)msg.textContent='';const finalErrors=errorsForStep(0).concat(errorsForStep(1),errorsForStep(2),errorsForStep(3));if(obs.value.length>1000)finalErrors.push(es?'LAS OBSERVACIONES DEBEN TENER HASTA 1000 CARACTERES.':'AS OBSERVAÇÕES DEVEM TER NO MÁXIMO 1000 CARACTERES.');const file=form.elements.proposalFile.files?.[0];if(file&&file.type!=='application/pdf')finalErrors.push(es?'EL ARCHIVO DEBE SER PDF.':'O ARQUIVO DEVE SER PDF.');if(file&&file.size>10*1024*1024)finalErrors.push(es?'EL PDF DEBE TENER HASTA 10 MB.':'O PDF DEVE TER NO MÁXIMO 10 MB.');if(!form.elements.privacyAccepted.checked)finalErrors.push(es?'ACEPTA EL AVISO DE PRIVACIDAD PARA CONTINUAR.':'ACEITE O AVISO DE PRIVACIDADE PARA CONTINUAR.');if(finalErrors.length){openModal([...new Set(finalErrors)]);return}const fd=new FormData(form);const contact=String(fd.get('contactName')||'').trim(),email=String(fd.get('email')||'').trim(),tax=digits(fd.get('taxId')),proposals=fd.getAll('proposalTypes').map(String);fd.set('contactName',upper(contact));fd.set('contactRole',upper(fd.get('contactRole')));fd.set('whatsapp',digits(fd.get('whatsapp')));fd.set('email',email.toLowerCase());fd.set('taxId',tax);fd.set('state',upper(stateSelect.value));fd.set('city',upper(citySelect.value));fd.set('privacyAccepted','1');fd.set('privacyNoticeVersion',privacyNoticeVersion);fd.set('privacyNoticeLocale',es?'es':'pt-BR');const token=fd.get('cf-turnstile-response');fd.set('turnstileToken',String(token||''));fd.delete('cf-turnstile-response');submitBtn.disabled=true;try{const r=await fetch(`${apiBase}/api/public/partnerships`,{method:'POST',body:fd});const result=await r.json().catch(()=>({}));if(!r.ok){const map={privacy_required:es?'ACEPTA EL AVISO DE PRIVACIDAD.':'ACEITE O AVISO DE PRIVACIDADE.',proposal_too_large:es?'EL PDF DEBE TENER HASTA 10 MB.':'O PDF DEVE TER ATÉ 10 MB.',proposal_pdf_only:es?'EL ARCHIVO DEBE SER PDF.':'O ARQUIVO DEVE SER PDF.',rate_limited:es?'D