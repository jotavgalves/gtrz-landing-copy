---
import type { Locale } from '@/lib/cms';

const { locale, ogImage='' } = Astro.props as { locale:Locale; ogImage?:string };
const es=locale==='es';
const apiBase=import.meta.env.PUBLIC_API_BASE||'';
const title=es?'GTRZ Eventos — Próximas noches':'GTRZ Eventos — Próximas noites';
const description=es
  ?'Agenda oficial de eventos GTRZ. Elige tu próxima noche.'
  :'Agenda oficial de eventos GTRZ. Escolha sua próxima noite.';
const canonicalPtUrl=new URL('/',Astro.url.origin).toString();
const canonicalEsUrl=new URL('/?lang=es',Astro.url.origin).toString();
const canonicalUrl=es?canonicalEsUrl:canonicalPtUrl;
const absoluteOgImage=ogImage?new URL(ogImage,Astro.url.origin).toString():'';
const socialLocale=es?'es_ES':'pt_BR';
const socialLocaleAlternate=es?'pt_BR':'es_ES';
---
<!doctype html>
<html lang={es?'es':'pt-BR'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#070707" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-BR" href={canonicalPtUrl} />
    <link rel="alternate" hreflang="es" href={canonicalEsUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalPtUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GTRZ Eventos" />
    <meta property="og:locale" content={socialLocale} />
    <meta property="og:locale:alternate" content={socialLocaleAlternate} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {absoluteOgImage&&<meta property="og:image" content={absoluteOgImage} />}
    {absoluteOgImage&&<meta property="og:image:secure_url" content={absoluteOgImage} />}
    {absoluteOgImage&&<meta property="og:image:alt" content={es?'Próximos eventos de GTRZ Eventos':'Próximos eventos da GTRZ Eventos'} />}

    <meta name="twitter:card" content={absoluteOgImage?'summary_large_image':'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage&&<meta name="twitter:image" content={absoluteOgImage} />}
    {absoluteOgImage&&<meta name="twitter:image:alt" content={es?'Próximos eventos de GTRZ Eventos':'Próximos eventos da GTRZ Eventos'} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script define:vars={{apiBase,locale}}>
      const sessionKey='gtrz_session_id';
      const attributionKey='gtrz_attribution';
      let sessionId=localStorage.getItem(sessionKey);
      if(!sessionId){sessionId=crypto.randomUUID();localStorage.setItem(sessionKey,sessionId);}
      const params=new URLSearchParams(location.search);
      const incoming={
        utmSource:params.get('utm_source')||undefined,
        utmMedium:params.get('utm_medium')||undefined,
        utmCampaign:params.get('utm_campaign')||undefined,
        utmContent:params.get('utm_content')||undefined,
        trackingLink:params.get('gtrz_link')||undefined
      };
      let stored={};
      try{stored=JSON.parse(sessionStorage.getItem(attributionKey)||'{}');}catch{}
      const hasIncoming=Object.values(incoming).some(Boolean);
      const acquisition=hasIncoming?incoming:stored;
      if(hasIncoming)sessionStorage.setItem(attributionKey,JSON.stringify(incoming));
      const send=(eventName,extra={})=>{
        const payload=JSON.stringify({eventName,path:location.pathname,language:locale,referrer:document.referrer||undefined,sessionId,...acquisition,...extra});
        const url=`${apiBase}/api/analytics/collect`;
        if(navigator.sendBeacon)navigator.sendBeacon(url,new Blob([payload],{type:'application/json'}));
        else fetch(url,{method:'POST',headers:{'content-type':'application/json'},body:payload,keepalive:true}).catch(()=>{});
      };
      window.gtrzTrack=send;
      send('page_view',{section:'event_hub'});
      document.addEventListener('click',(event)=>{
        const el=event.target.closest('[data-track]');
        if(el)send(el.dataset.trackEvent||'cta_click',{element:el.dataset.track,section:'event_hub'});
      });
    </script>
  </body>
</html>

<style is:global>
  :root{--hub-bg:#070707;--hub-paper:#f2eee8;--hub-red:#ff241a;--hub-white:#fffdf9;--hub-muted:#99918d;--hub-line:rgba(255,255,255,.12)}
  *{box-sizing:border-box}
  html{background:var(--hub-bg);scroll-behavior:smooth}
  body{margin:0;background:var(--hub-bg);color:var(--hub-white);font-family:'Manrope',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  a{color:inherit;text-decoration:none}
  button,input,select,textarea{font:inherit}
  img{display:block;max-width:100%}
</style>
