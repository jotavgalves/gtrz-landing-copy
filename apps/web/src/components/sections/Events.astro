---
import type { CmsEvent,Locale } from '@/lib/cms';
import { API_BASE } from '@/lib/api';
const {events,locale,content={}}=Astro.props as {events:CmsEvent[];locale:Locale;content?:Record<string,any>};
const es=locale==='es';
const c={eyebrow:'Agenda GTRZ',title:'EVENTOS.',body:es?'Elige tu próxima noche GTRZ.':'Escolha sua próxima noite GTRZ.',emptyTitle:es?'PRÓXIMAMENTE.':'EM BREVE.',emptyBody:es?'Nuevas ediciones entran aquí cuando estén listas para ser anunciadas.':'Novas edições entram aqui assim que estiverem prontas para ser anunciadas.',cta:es?'Seguir en Instagram':'Acompanhar no Instagram',secondaryCta:es?'Hablar con GTRZ':'Falar com a GTRZ',statusComingSoon:es?'Próximamente':'Em breve',statusSalesOpen:es?'Entradas disponibles':'Ingressos disponíveis',statusSoldOut:es?'Agotado':'Esgotado',statusPast:es?'Realizado':'Realizado',statusActive:es?'Evento activo':'Evento ativo',activeCta:es?'Ver evento':'Ver evento',pastCta:es?'Revivir la edición':'Rever a edição',...content};
const formatDate=(iso:string)=>{try{return new Intl.DateTimeFormat(es?'es-ES':'pt-BR',{day:'2-digit',month:'short',year:'numeric'}).format(new Date(iso)).replace('.','').toUpperCase()}catch{return ''}};
const parseTheme=(event:CmsEvent)=>{try{return JSON.parse(event.theme_json||'{}')}catch{return {}}};
const posterId=(event:CmsEvent)=>{const theme=parseTheme(event);return theme.posterMediaId||theme.poster_media_id||event.hero_media_id||null};
const mediaUrl=(id?:string|null)=>id?`${API_BASE}/api/media/${encodeURIComponent(id)}`:'';
const statusLabel=(event:CmsEvent)=>event.status==='published'?c.statusComingSoon:event.status==='sales_open'?c.statusSalesOpen:event.status==='sold_out'?c.statusSoldOut:['finished','archived'].includes(event.status)?c.statusPast:c.statusActive;
const locationLabel=(event:CmsEvent)=>[event.city,event.state].filter(Boolean).join(' · ');
const safeColor=(v:any,fallback:string)=>/^#[0-9a-f]{6}$/i.test(String(v||''))?String(v):fallback;
const clamp=(v:any,min:number,max:number,fallback:number)=>{const n=Number(v);return Number.isFinite(n)?Math.max(min,Math.min(max,n)):fallback};
---
<section id="eventos" class="events events-premium" data-section="events">
  <div class="wrap">
    <div class="section-head events-head reveal"><div><div class="eyebrow">{c.eyebrow}</div><h2 class="display">{c.title}</h2></div><p>{c.body}</p></div>
    {events.length ? (
      <div class:list={['event-showcase',`event-count-${Math.min(events.length,4)}`]}>
        {events.map((event,index)=>{
          const past=['finished','archived'].includes(event.status);
          const comingSoon=event.status==='published';
          const artwork=mediaUrl(posterId(event));
          const location=locationLabel(event);
          const theme=parseTheme(event);
          const titleDesign=theme.posterTitle||{};
          const titleMode=titleDesign.mode==='artwork'?'artwork':'text';
          const titleText=String(titleDesign.text||event.title||event.slug);
          const titleColor=safeColor(titleDesign.color,'#fffdf8');
          const glowEnabled=titleDesign.glowEnabled===true;
          const glowColor=safeColor(titleDesign.glowColor,titleColor);
          const glowBlur=clamp(titleDesign.glowBlur,0,48,18);
          const glowOpacity=clamp(titleDesign.glowOpacity,0,1,.7);
          const scale=clamp(titleDesign.scale,50,180,100);
          const fontId=titleDesign.fontMediaId||null;
          const titleArtwork=mediaUrl(titleDesign.artworkMediaId||null);
          const fontName=`GTRZEventTitle_${String(event.id).replace(/[^a-zA-Z0-9_]/g,'')}`;
          const textShadow=glowEnabled?`0 0 ${glowBlur}px color-mix(in srgb, ${glowColor} ${Math.round(glowOpacity*100)}%, transparent)`:undefined;
          return <article class:list={['event-showcase-card','reveal',index===0&&'is-lead',past&&'is-past',comingSoon&&'is-coming-soon',artwork?'has-poster':'missing-poster']}>
            {fontId&&<style is:inline>{`@font-face{font-family:"${fontName}";src:url("${mediaUrl(fontId)}");font-display:swap}`}</style>}
            <a class="event-showcase-link" href={`/eventos/${event.slug}?lang=${locale}`} data-track={`events.${event.slug}`}>
              <div class:list={['event-showcase-media',artwork?'has-art':'no-art']}>
                {artwork?<img src={artwork} alt={event.title||event.slug} loading={index===0?'eager':'lazy'} />:<div class="event-showcase-fallback-art" aria-hidden="true"><span class="fallback-kicker">GTRZ · {location||'EVENTO'}</span><i></i></div>}
                <div class="event-showcase-shade"></div><div class="event-showcase-status"><i></i>{statusLabel(event)}</div>
              </div>
              <div class="event-showcase-copy">
                <div class="event-showcase-meta">{location&&<span class="event-showcase-city"><i aria-hidden="true"></i>{location}</span>}<span class="event-showcase-date">{formatDate(event.starts_at)}</span></div>
                {titleMode==='artwork'&&titleArtwork?<img class="event-showcase-title-art" src={titleArtwork} alt={event.title||event.slug} style={`--title-scale:${scale/100};${glowEnabled?`filter:drop-shadow(0 0 ${glowBlur}px ${glowColor});`:''}`} />:<h3 class="display event-custom-title" style={`font-family:${fontId?`"${fontName}"`:'inherit'};color:${titleColor};text-shadow:${textShadow||'none'};--title-scale:${scale/100}`}>{titleText}</h3>}
                {event.summary&&<p>{event.summary}</p>}
                <span class="event-showcase-cta"><span>{past?c.pastCta:c.activeCta}</span><b aria-hidden="true">→</b></span>
              </div>
            </a>
          </article>
        })}
      </div>
    ) : <div class="events-empty reveal"><div class="events-empty-copy"><div class="events-empty-kicker"><span></span>{c.eyebrow}</div><h3 class="display">{c.emptyTitle}</h3><p>{c.emptyBody}</p><div class="events-empty-actions"><a class="btn btn-red" href="#instagram" data-track="events.empty.instagram">{c.cta}</a><a class="btn" href="#contato" data-track="events.empty.contact">{c.secondaryCta}</a></div></div><div class="events-empty-art" aria-hidden="true"><img src="/brand/gtrz-symbol.svg" alt="" /></div></div>}
  </div>
</section>
<style>
.events-premium .event-showcase.event-count-2 .event-showcase-card{min-height:0}
.events-premium .event-showcase.event-count-2 .event-showcase-media.has-art{aspect-ratio:16/11;max-height:360px}
.events-premium .event-showcase .event-showcase-media.no-art{aspect-ratio:auto!important;min-height:180px!important;max-height:180px!important}
.events-premium .event-showcase .event-showcase-media.no-art .event-showcase-fallback-art{padding:20px 22px;justify-content:flex-end}
.events-premium .event-showcase .event-showcase-media.no-art .fallback-kicker{margin-bottom:8px}
.events-premium .event-showcase .event-showcase-media.no-art .event-showcase-fallback-art i{margin-top:8px}
.events-premium .event-showcase.event-count-2 .event-showcase-copy{min-height:190px;padding:22px 24px 22px}
.events-premium .event-showcase.event-count-2 .event-showcase-meta{margin-bottom:15px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.events-premium .event-showcase-date{color:#857d79;font-size:.68rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}
.events-premium .event-showcase-city{display:inline-flex;align-items:center;gap:7px;min-height:28px;padding:6px 10px;border:1px solid rgba(255,42,32,.5);border-radius:999px;background:linear-gradient(180deg,rgba(255,42,32,.16),rgba(255,42,32,.08));color:#ff4b43;font-size:.64rem;font-weight:950;letter-spacing:.085em;text-transform:uppercase;line-height:1;box-shadow:0 0 0 1px rgba(255,42,32,.04) inset}
.events-premium .event-showcase-city i{display:block;width:5px;height:5px;border-radius:50%;background:#ff2a20;box-shadow:0 0 8px rgba(255,42,32,.55)}
.events-premium .event-showcase.event-count-2 .event-showcase-title-art{max-height:92px;max-width:88%}
.events-premium .event-showcase.event-count-2 .event-showcase-copy h3{font-size:clamp(2.25rem,3.2vw,3.35rem)}
.events-premium .event-showcase.event-count-2 .event-showcase-cta{margin-top:auto}
.events-premium .event-showcase-cta{position:relative;display:inline-flex!important;align-items:center!important;justify-content:flex-start!important;gap:9px!important;width:max-content!important;min-height:36px!important;padding:9px 0 7px!important;border:0!important;border-radius:0!important;background:transparent!important;color:#fff!important;text-decoration:none!important;line-height:1!important;letter-spacing:.08em!important;text-transform:uppercase!important;transition:color .18s ease!important}
.events-premium .event-showcase-cta::after{content:"";position:absolute;left:0;bottom:0;width:38px;height:2px;background:#ff2a20;transition:width .2s ease}
.events-premium .event-showcase-cta>span{display:block;padding:0!important}
.events-premium .event-showcase-cta b{display:inline!important;width:auto!important;height:auto!important;min-width:0!important;min-height:0!important;padding:0!important;margin:0!important;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;color:#ff2a20!important;font:inherit!important;font-size:1rem!important;line-height:1!important;transform:none!important;transition:transform .2s ease!important}
.events-premium .event-showcase-cta b::before,.events-premium .event-showcase-cta b::after{content:none!important;display:none!important}
.events-premium .event-showcase-link:hover .event-showcase-cta::after{width:100%}
.events-premium .event-showcase-link:hover .event-showcase-cta b{transform:translateX(4px)!important}
@media(max-width:700px){.events-premium .event-showcase .event-showcase-media.no-art{min-height:150px!important;max-height:none!important}.events-premium .event-showcase.event-count-2 .event-showcase-copy{min-height:150px;padding:16px 14px}.events-premium .event-showcase.event-count-2 .event-showcase-title-art{max-height:60px}.events-premium .event-showcase-city{min-height:25px;padding:5px 8px;font-size:.58rem}.events-premium .event-showcase-cta{min-height:34px!important;padding:8px 0 6px!important}.events-premium .event-showcase-cta::after{width:32px}}
</style>
