---
const { locale='pt-BR', content={} } = Astro.props as { locale?:'pt-BR'|'es'; content?:Record<string,any> };
const defaults=locale==='es'?['GTRZ EVENTOS','RECIFE','JOÃO PESSOA','CULTURA LATINA','EXPERIENCIAS','PRODUCCIÓN']:['GTRZ EVENTOS','RECIFE','JOÃO PESSOA','CULTURA LATINA','EXPERIÊNCIAS','PRODUÇÃO'];
const source=Array.isArray(content.marqueeItems)&&content.marqueeItems.length?content.marqueeItems:defaults;
const items=source.map((item:any)=>String(typeof item==='string'?item:item?.name||'').replace(/[•·]+\s*$/g,'').trim()).filter(Boolean);
const duration=Math.max(24,Math.min(50,items.length*4.6));
---
<div class="runner" aria-label={locale==='es'?'Temas de GTRZ':'Temas da GTRZ'} style={`--runner-duration:${duration}s`}>
  <div class="runner-track">
    {[0,1,2,3].map(copy=><div class="runner-group" aria-hidden={copy===0?undefined:'true'}>
      {items.map((item:string)=><span><b>{item}</b><i aria-hidden="true"></i></span>)}
    </div>)}
  </div>
</div>
<style>
.runner{width:100%;height:42px;overflow:hidden;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.07);background:#0a0a0a;white-space:nowrap;contain:paint;display:flex;align-items:center}
.runner-track{display:flex;width:max-content;align-items:center;will-change:transform;animation:runner-loop var(--runner-duration,30s) linear infinite}
.runner-group{display:flex;flex:0 0 auto;align-items:center;height:42px}
.runner-group span{display:inline-flex;align-items:center;flex:0 0 auto;gap:16px;padding:0 18px 0 0;color:#716a67;font-size:.61rem;font-weight:900;line-height:1;letter-spacing:.095em;text-transform:uppercase}
.runner-group span::before,.runner-group span::after{content:none!important;display:none!important}
.runner-group span b{font:inherit;line-height:1;white-space:nowrap}
.runner-group span i{display:block;flex:0 0 auto;width:3px;height:3px;border-radius:50%;background:var(--red,#ff1a12);box-shadow:none}
@keyframes runner-loop{to{transform:translate3d(-25%,0,0)}}
@media(max-width:700px){.runner,.runner-group{height:38px}.runner-group span{gap:13px;padding-right:15px;font-size:.56rem;letter-spacing:.085em}.runner-group span i{width:3px;height:3px}}
@media(prefers-reduced-motion:reduce){.runner-track{animation-duration:70s}}
</style>
