---
import type { CmsTeamMember } from '@/lib/cms';
const {locale,content={},team=[]}=Astro.props as {locale:'pt-BR'|'es';content:Record<string,any>;team:CmsTeamMember[]};
const es=locale==='es';
const apiBase=import.meta.env.PUBLIC_API_BASE||'';
const c={
  eyebrow:es?'Equipo GTRZ':'Equipe GTRZ',
  title:es?'LAS PERSONAS DETRÁS DE CADA NOCHE.':'AS PESSOAS POR TRÁS DE CADA NOITE.',
  body:es?'Producción, dirección, comunicación y operación. GTRZ se construye con personas de distintas funciones y el mismo compromiso: llevar cada edición del concepto a la pista.':'Produção, direção, comunicação e operação. A GTRZ é construída por pessoas com funções diferentes e o mesmo compromisso: levar cada edição do conceito à pista.',
  fallbackRole:'GTRZ',
  instagramLabel:'Instagram ↗',
  emptyText:es?'El equipo de esta edición será presentado muy pronto.':'A equipe desta edição será apresentada em breve.',
  ...content
};
const parts=String(c.title).trim().split(/\s+/);const accent=parts.pop()||'';const lead=parts.join(' ');
const initials=(name:string)=>name.trim().split(/\s+/).slice(0,2).map(part=>part[0]||'').join('').toUpperCase();
---
<section id="quem" class="faces" data-section="team">
  <div class="wrap">
    <div class="section-head reveal">
      <div><div class="eyebrow">{c.eyebrow}</div><h2 class="display">{lead} <span class="red">{accent}</span></h2></div>
      <p>{c.body}</p>
    </div>
    {team.length ? <div class="faces-grid">{team.map(member=><article class="person reveal">
      {member.media_id
        ? <div class="person-photo"><img src={`${apiBase}/api/media/${member.media_id}`} alt={member.name} loading="lazy"/></div>
        : <div class="person-photo person-photo--placeholder" aria-hidden="true"><span>{initials(member.name)}</span></div>}
      <div class="person-copy">
        <small>{member.role_label||c.fallbackRole}</small>
        <h3>{member.name}</h3>
        {member.bio&&<p>{member.bio}</p>}
        {member.instagram_url&&<a href={member.instagram_url} target="_blank" rel="noopener" data-track={`team.instagram.${member.id}`} data-track-event="instagram_click">{c.instagramLabel}</a>}
      </div>
    </article>)}</div> : <div class="empty-state">{c.emptyText}</div>}
  </div>
</section>
