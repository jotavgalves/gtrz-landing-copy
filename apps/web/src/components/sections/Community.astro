---
const {locale,content={}}=Astro.props;const es=locale==='es';const c={eyebrow:es?'Quién hace que suceda':'Quem faz acontecer',title:es?'POR DETRÁS DE GTRZ.':'POR TRÁS DA GTRZ.',body:es?'Personas reales construyendo cada experiencia.':'Pessoas reais construindo cada experiência.',freelancerTitle:es?'Trabaja con nosotros':'Trabalhe com a gente',freelancerBody:es?'Forma parte de nuestra base para futuras producciones.':'Faça parte do nosso banco para futuras produções.',partnershipTitle:es?'Construyamos algo juntos':'Vamos construir juntos',partnershipBody:es?'Marcas, espacios, artistas y proveedores.':'Marcas, casas, artistas e fornecedores.',...content};
---
<section id="quem" class="dark-section" data-section="team"><div class="shell"><div class="section-head"><div><span class="eyebrow">{c.eyebrow}</span><h2>{c.title}</h2></div><p>{c.body}</p></div><div class="feature-grid"><article><small>GTRZ</small><h3>{es?'Venezolanos + brasileños':'Venezuelanos + brasileiros'}</h3><p>{es?'Una construcción conjunta entre culturas.':'Uma construção conjunta entre culturas.'}</p></article><article id="trabalhe"><small>FREELANCERS</small><h3>{c.freelancerTitle}</h3><p>{c.freelancerBody}</p><a href="/trabalhe-conosco" data-track="freelancers.open">{es?'Registrarme':'Quero me cadastrar'}</a></article><article id="parcerias"><small>{es?'ALIANZAS':'PARCERIAS'}</small><h3>{c.partnershipTitle}</h3><p>{c.partnershipBody}</p><a href="/parcerias" data-track="partnerships.open">{es?'Proponer alianza':'Propor parceria'}</a></article></div></div></section>
