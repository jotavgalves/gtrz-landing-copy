---
const { locale, content={} } = Astro.props as { locale: 'pt-BR' | 'es'; content?:Record<string,any> };
const es = locale === 'es';
const c={
  eyebrow:es?'Manifiesto':'Manifesto',
  title:es?'HACER QUE SUCEDA ES NUESTRO LENGUAJE.':'FAZER ACONTECER É A NOSSA LINGUAGEM.',
  body:es?'GTRZ no necesita parecer más grande de lo que es. Necesita parecer tan bien pensada como realmente es: fuerte, autoral, cercana al público y obsesionada con la entrega.':'A GTRZ não precisa parecer maior do que é. Precisa parecer tão bem pensada quanto realmente é: forte, autoral, próxima do público e obcecada por entrega.',
  ...(content.manifesto||{}),
  ...(content.manifestoEyebrow?{eyebrow:content.manifestoEyebrow}:{}),
  ...(content.manifestoTitle?{title:content.manifestoTitle}:{}),
  ...(content.manifestoBody?{body:content.manifestoBody}:{})
};
---
<section class="manifesto" data-section="manifesto">
  <div class="wrap reveal">
    <div class="eyebrow">{c.eyebrow}</div>
    <h2 class="display">{c.title}</h2>
    <p>{c.body}</p>
  </div>
</section>
