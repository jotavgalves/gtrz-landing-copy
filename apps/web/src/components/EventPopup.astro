---
import type { CmsEvent, Locale, SiteSettings } from '@/lib/cms';
import { API_BASE } from '@/lib/api';
import { getPublicCopy } from '@/lib/public-copy';

const { events, locale, siteSettings = {} } = Astro.props as { events: CmsEvent[]; locale: Locale; siteSettings?: SiteSettings };
const settings=siteSettings.event_popup||{};
const c=getPublicCopy(siteSettings,locale,'popup');
const isEs=locale==='es';
const forcePreview=Astro.url.searchParams.get('popup')==='1';
const editorPreview=Astro.url.searchParams.get('popupEditor')==='1';
const enabled=forcePreview||settings.enabled!==false;
const publicEvents=events.filter(event=>['published','sales_open','sold_out'].includes(event.status));
const selectedEvent=settings.selectedEventId?publicEvents.find(event=>event.id===settings.selectedEventId):undefined;
const eventPool=selectedEvent?[selectedEvent]:publicEvents;
const activeEvents=eventPool.slice(0,Math.max(1,Math.min(6,Number(settings.maxEvents)||4)));
const frequency=forcePreview?'always':(settings.frequency||'session');
const delayMs=forcePreview?80:Math.max(0,Math.min(15000,Number(settings.delayMs??700)));
const single=activeEvents.length===1;
const cityCount=new Set(activeEvents.map(event=>`${event.city||''}|${event.state||''}`.toLowerCase())).size;
const eventCount=activeEvents.length;
const multiMeta=isEs?`${cityCount} ${cityCount===1?'CIUDAD':'CIUDADES'} · ${eventCount} ${eventCount===1?'EVENTO':'EVENTOS'}`:`${cityCount} ${cityCount===1?'CIDADE':'CIDADES'} · ${eventCount} ${eventCount===1?'EVENTO':'EVENTOS'}`;
const defaultUi=isEs?{
  kicker:'AGENDA GTRZ',titleTop:'PRÓXIMAS NOCHES GTRZ.',titleBottom:'ELIGE LA TUYA.',subtitle:'Elige tu próxima noche.',from:'Desde',view:'VER EVENTO',sold:'AGOTADO',continue:'CONTINUAR EN EL SITIO',venue:'LUGAR',coming:'PRÓXIMAMENTE',available:'ENTRADAS DISPONIBLES'
}:{
  kicker:'AGENDA GTRZ',titleTop:'PRÓXIMAS NOITES GTRZ.',titleBottom:'ESCOLHA A SUA.',subtitle:'Escolha sua próxima noite.',from:'A partir de',view:'VER EVENTO',sold:'ESGOTADO',continue:'CONTINUAR NO SITE',venue:'LOCAL',coming:'EM BREVE',available:'INGRESSOS DISPONÍVEIS'
};
const visual={
  kicker:defaultUi.kicker,titleTop:defaultUi.titleTop,titleBottom:defaultUi.titleBottom,subtitle:defaultUi.subtitle,continueText:defaultUi.continue,
  kickerColor:'#9a9491',titleColor:'#fffdf8',highlightColor:'#ff2118',subtitleColor:'#9a9491',continueColor:'#ffffff',cardTextColor:'#fffdf8',cardMetaColor:'#8b8582',cardAccent:'#ff2118',ctaBg:'#111111',ctaText:'#ffffff',popupBg:'#090909',popupBorder:'#282828',
  headlineX:0,headlineY:0,subtitleX:0,subtitleY:0,cardsX:0,cardsY:0,continueX:0,continueY:0,cardTitleY:6,modalWidth:940,cardMediaWidth:120,cardHeight:166,gap:12,
  headlineAlign:'left',subtitleAlign:'left',continueAlign:'center',cardsAlign:'stretch',
  ...(settings.visual||{})
};
const parseTheme=(event:CmsEvent)=>{try{return JSON.parse(event.theme_json||'{}')}catch{return {}}};
const mediaId=(event:CmsEvent)=>{const theme=parseTheme(event);return theme.posterMediaId||theme.poster_media_id||event.hero_media_id||null};
const mediaUrl=(id?:string|null)=>id?`${API_BASE}/api/media/${encodeURIComponent(id)}`:'';
const shortDate=(event:CmsEvent)=>new Intl.DateTimeFormat(isEs?'es-ES':'pt-BR',{day:'2-digit',month:'short'}).format(new Date(event.starts_at)).replace('.','').toUpperCase();
const shortTime=(event:CmsEvent)=>{const value=new Intl.DateTimeFormat('pt-BR',{hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date(event.starts_at));return value.endsWith(':00')?`${value.slice(0,2)}H`:value};
const price=(event:CmsEvent)=>event.min_price_cents==null?'':new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL',maximumFractionDigits:Number(event.min_price_cents)%100===0?0:2}).format(Number(event.min_price_cents)/100);
const location=(event:CmsEvent)=>event.venue_name||[event.city,event.state].filter(Boolean).join(' · ');
const cityLabel=(event:CmsEvent)=>[event.city,event.state].filter(Boolean).join(' · ');
const statusText=(event:CmsEvent)=>event.status==='sales_open'?defaultUi.available:event.status==='sold_out'?defaultUi.sold:defaultUi.coming;
const safeColor=(v:any,fallback:string)=>/^#[0-9a-f]{6}$/i.test(String(v||''))?String(v):fallback;
const clamp=(v:any,min:number,max:number,fallback:number)=>{const n=Number(v);return Number.isFinite(n)?Math.max(min,Math.min(max,n)):fallback};
const cssVars=`--popup-width:${clamp(visual.modalWidth,760,1120,940)}px;--headline-x:${clamp(visual.headlineX,-120,120,0)}px;--headline-y:${clamp(visual.headlineY,-80,80,0)}px;--subtitle-x:${clamp(visual.subtitleX,-120,120,0)}px;--subtitle-y:${clamp(visual.subtitleY,-80,80,0)}px;--cards-x:${clamp(visual.cardsX,-80,80,0)}px;--cards-y:${clamp(visual.cardsY,-60,60,0)}px;--continue-x:${clamp(visual.continueX,-120,120,0)}px;--continue-y:${clamp(visual.continueY,-60,60,0)}px;--card-title-y:${clamp(visual.cardTitleY,-20,50,6)}px;--media-width:${clamp(visual.cardMediaWidth,0,190,120)}px;--card-height:${clamp(visual.cardHeight,140,240,166)}px;--card-gap:${clamp(visual.gap,6,32,12)}px;--kicker-color:${safeColor(visual.kickerColor,'#9a9491')};--title-color:${safeColor(visual.titleColor,'#fffdf8')};--highlight-color:${safeColor(visual.highlightColor,'#ff2118')};--subtitle-color:${safeColor(visual.subtitleColor,'#9a9491')};--continue-color:${safeColor(visual.continueColor,'#fff')};--card-text:${safeColor(visual.cardTextColor,'#fffdf8')};--card-meta:${safeColor(visual.cardMetaColor,'#8b8582')};--card-accent:${safeColor(visual.cardAccent,'#ff2118')};--cta-bg:${safeColor(visual.ctaBg,'#111111')};--cta-text:${safeColor(visual.ctaText,'#ffffff')};--popup-bg:${safeColor(visual.popupBg,'#090909')};--popup-border:${safeColor(visual.popupBorder,'#282828')}`;
---
{enabled&&activeEvents.length>0&&<div class="event-popup popup-v5" data-event-popup data-editor-preview={editorPreview?'true':'false'} hidden aria-hidden="true" style={cssVars}>
  <div class:list={["event-popup-card",single?'is-single':'is-multiple']} role="dialog" aria-modal="true" aria-labelledby="eventPopupTitle">
    <div class="popup-head">
      <div class="popup-head-brand"><img src="/brand/gtrz-symbol.svg" alt=""/><small data-editor-text="kicker">{visual.kicker}</small></div>
      <button class="popup-close" type="button" aria-label={c.closeLabel} data-popup-close><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15"/></svg></button>
    </div>
    <div class="popup-layout">
      <div class="popup-copy">
        <div class:list={[single?'popup-city':'popup-multi-meta']}><i></i>{single?cityLabel(activeEvents[0]):multiMeta}</div>
        <div class="popup-title-block" data-editor-block="headline"><h2 class="display" id="eventPopupTitle"><span data-editor-text="titleTop">{visual.titleTop}</span><span class="red" data-editor-text="titleBottom">{visual.titleBottom}</span></h2></div>
        <p class="popup-subtitle" data-editor-block="subtitle" data-editor-text="subtitle">{visual.subtitle}</p>
      </div>
      <div class:list={["popup-events",single?'single-event':'multiple-events']} data-editor-block="cards">
        {activeEvents.map(event=>{
          const artwork=mediaUrl(mediaId(event));
          const theme=parseTheme(event);
          const titleDesign=theme.posterTitle||{};
          const titleMode=titleDesign.mode==='artwork'?'artwork':'text';
          const titleText=String(titleDesign.text||event.title||event.slug);
          const titleColor=safeColor(titleDesign.color,visual.cardTextColor||'#fffdf8');
          const glowEnabled=titleDesign.glowEnabled===true;
          const glowColor=safeColor(titleDesign.glowColor,titleColor);
          const glowBlur=clamp(titleDesign.glowBlur,0,48,18);
          const glowOpacity=clamp(titleDesign.glowOpacity,0,1,.7);
          const scale=clamp(titleDesign.scale,50,180,100);
          const titleArtwork=mediaUrl(titleDesign.artworkMediaId||null);
          const fontId=titleDesign.fontMediaId||null;
          const fontName=`GTRZPopupTitle_${String(event.id).replace(/[^a-zA-Z0-9_]/g,'')}`;
          const textShadow=glowEnabled?`0 0 ${glowBlur}px color-mix(in srgb, ${glowColor} ${Math.round(glowOpacity*100)}%, transparent)`:undefined;
          return <a class="popup-event-option" href={isEs?`/es/eventos/${event.slug}`:`/eventos/${event.slug}`} data-track={`popup.event.${event.slug}`} data-track-event="popup_click">
            {fontId&&<style is:inline>{`@font-face{font-family:"${fontName}";src:url("${mediaUrl(fontId)}");font-display:swap}`}</style>}
            <div class:list={["popup-event-media",artwork?'has-art':'no-art']}>
              {artwork?<img src={artwork} alt={event.title||event.slug} loading="eager"/>:<div class="popup-media-placeholder" aria-hidden="true"><span>GTRZ</span></div>}
              <div class="popup-event-media-shade"></div>
              <span class:list={["popup-ticket-status",event.status==='sales_open'?'open':event.status==='sold_out'?'sold':'coming']}>{statusText(event)}</span>
            </div>
            <div class="popup-event-content">
              <div class="popup-event-meta"><span>{cityLabel(event)}</span><span>{shortDate(event)} · {shortTime(event)}</span></div>
              <div class="popup-content-title">
                {titleMode==='artwork'&&titleArtwork?<img class="popup-custom-title-art" src={titleArtwork} alt={event.title||event.slug} style={`--popup-title-scale:${scale/100};${glowEnabled?`filter:drop-shadow(0 0 ${glowBlur}px ${glowColor});`:''}`}/>:<strong class="popup-custom-title-text" style={`font-family:${fontId?`"${fontName}"`:'inherit'};color:${titleColor};text-shadow:${textShadow||'none'};--popup-title-scale:${scale/100}`}>{titleText}</strong>}
              </div>
              <div class="popup-event-place"><small>{defaultUi.venue}</small><b>{location(event)}</b></div>
              <div class="popup-event-footer">
                <div>{event.status==='sales_open'&&price(event)?<><small>{defaultUi.from}</small><b>{price(event)}</b></>:<span></span>}</div>
                <span class="popup-event-cta">{defaultUi.view}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></span>
              </div>
            </div>
          </a>
        })}
      </div>
      <button class="popup-continue" type="button" data-popup-close data-editor-block="continue"><span data-editor-text="continueText">{visual.continueText}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"/></svg></button>
    </div>
  </div>
</div>}
<style>
.popup-v5 .event-popup-card{width:min(var(--popup-width),calc(100vw - 36px));max-height:calc(100dvh - 36px);border:1px solid var(--popup-border);border-radius:22px;background:var(--popup-bg)}
.popup-v5 .popup-head{min-height:58px;padding:14px 18px 12px}.popup-v5 .popup-head-brand{display:flex;align-items:center;gap:10px;min-height:30px}.popup-v5 .popup-head-brand img{display:block;width:28px;height:28px;flex:0 0 28px}.popup-v5 .popup-head-brand small{display:block;min-height:0;margin:0;padding:0;color:var(--kicker-color);line-height:.95;transform:translateY(-2.5px)}
.popup-v5 .popup-layout{display:block;padding:18px 22px 20px;overflow:auto}.popup-v5 .popup-copy{display:block}.popup-v5 .popup-city,.popup-v5 .popup-multi-meta{margin:0 0 10px;padding:5px 8px;font-size:.5rem}.popup-v5 .popup-title-block{transform:translate(var(--headline-x),var(--headline-y));transition:transform .12s ease}.popup-v5 .popup-copy h2{max-width:760px;margin:0;font-size:clamp(2.1rem,4.4vw,3.65rem);line-height:.86;color:var(--title-color);text-align:var(--headline-align,left)}.popup-v5 .popup-copy h2 span{display:block}.popup-v5 .popup-copy h2 .red{color:var(--highlight-color)}.popup-v5 .popup-subtitle{max-width:520px;margin:12px 0 0;color:var(--subtitle-color);font-size:.78rem;line-height:1.45;text-align:var(--subtitle-align,left);transform:translate(var(--subtitle-x),var(--subtitle-y));transition:transform .12s ease}
.popup-v5 .popup-events{margin-top:18px;transform:translate(var(--cards-x),var(--cards-y));transition:transform .12s ease}.popup-v5 .multiple-events{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--card-gap)}.popup-v5 .single-event{display:grid;grid-template-columns:minmax(0,1fr)}
.popup-v5 .popup-event-option{display:grid!important;grid-template-columns:var(--media-width) minmax(0,1fr);min-height:var(--card-height);overflow:hidden;border:1px solid rgba(255,255,255,.12)!important;border-radius:16px!important;background:#0d0d0d!important;color:#fff!important;text-decoration:none!important}.popup-v5 .single-event .popup-event-option{grid-template-columns:min(calc(var(--media-width) + 28px),190px) minmax(0,1fr)}
.popup-v5 .popup-event-media{position:relative;min-height:var(--card-height)!important;height:100%;aspect-ratio:auto!important;background:#0a0a0a}.popup-v5 .popup-event-media.has-art>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.popup-v5 .popup-event-media.no-art{background:linear-gradient(145deg,#17100f,#090909 72%)}.popup-v5 .popup-media-placeholder{position:absolute;inset:0;display:grid;place-items:center;border:0!important;border-radius:0!important}.popup-v5 .popup-media-placeholder:before,.popup-v5 .popup-media-placeholder:after{display:none!important;content:none!important}.popup-v5 .popup-media-placeholder span{font-size:.72rem;font-weight:900;letter-spacing:.2em;color:rgba(255,255,255,.14)}.popup-v5 .popup-event-media-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.28));pointer-events:none}
.popup-v5 .popup-ticket-status{position:absolute;z-index:4;left:8px;top:8px;padding:5px 7px;border:1px solid rgba(255,255,255,.16);border-radius:999px;background:rgba(5,5,5,.76);font-size:.42rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase;white-space:nowrap}.popup-v5 .popup-ticket-status:before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;margin-right:5px;background:#ffb02e;box-shadow:0 0 9px rgba(255,176,46,.5)}.popup-v5 .popup-ticket-status.open:before{background:#4bdd86;box-shadow:0 0 9px rgba(75,221,134,.5)}.popup-v5 .popup-ticket-status.sold:before{background:#858585;box-shadow:none}
.popup-v5 .popup-event-content{display:flex;flex-direction:column;min-width:0;padding:14px 15px 13px}.popup-v5 .popup-event-meta{display:flex;justify-content:space-between;gap:10px;color:var(--card-meta);font-size:.48rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.popup-v5 .popup-content-title{display:flex;align-items:center;min-height:48px;margin-top:14px;overflow:visible;transform:translateY(var(--card-title-y))}.popup-v5 .popup-custom-title-text{display:block;max-width:100%;font-family:var(--font-display,"Arial Narrow",Impact,sans-serif);font-size:clamp(1.45rem,2.25vw,2.05rem);font-weight:900;line-height:.88;text-transform:uppercase;transform:scale(var(--popup-title-scale,1));transform-origin:left center;color:var(--card-text)}.popup-v5 .popup-custom-title-art{display:block!important;width:auto!important;height:auto!important;max-width:92%!important;max-height:64px!important;object-fit:contain!important;object-position:left center!important;transform:scale(var(--popup-title-scale,1));transform-origin:left center}.popup-v5 .popup-event-place{display:grid;gap:2px;margin-top:12px}.popup-v5 .popup-event-place small{color:#65605d;font-size:.43rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.popup-v5 .popup-event-place b{color:#d5cfcc;font-size:.66rem;line-height:1.3}.popup-v5 .popup-event-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:10px;border-top:1px solid rgba(255,255,255,.07)}.popup-v5 .popup-event-footer>div{display:grid;gap:1px}.popup-v5 .popup-event-footer small{color:#777;font-size:.42rem;text-transform:uppercase;font-weight:900}.popup-v5 .popup-event-footer b{font-size:.82rem}.popup-v5 .popup-event-cta{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:31px;padding:7px 11px;border:1px solid var(--card-accent);border-radius:999px;background:var(--cta-bg);color:var(--cta-text);font-size:.48rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase;line-height:1}.popup-v5 .popup-event-cta svg{width:13px;height:13px;flex:0 0 auto}.popup-v5 .popup-event-option:hover{border-color:color-mix(in srgb,var(--card-accent) 55%,transparent)!important}
.popup-v5 .popup-continue{display:flex;align-items:center;justify-content:center;gap:7px;width:max-content;margin:18px auto 0;padding:7px 10px;border:0;background:transparent;color:var(--continue-color);font-size:.57rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;transform:translate(var(--continue-x),var(--continue-y));transition:transform .12s ease,color .15s ease}.popup-v5 .popup-continue svg{width:14px;height:14px}.popup-v5 .popup-continue:hover{color:var(--card-accent)}
.popup-v5[data-editor-preview="true"] [data-editor-block]{position:relative;cursor:move;touch-action:none}.popup-v5[data-editor-preview="true"] [data-editor-block]:hover:after,.popup-v5[data-editor-preview="true"] [data-editor-block].editor-selected:after{content:"";position:absolute;inset:-5px;z-index:30;border:1px dashed rgba(255,54,45,.72);border-radius:7px;pointer-events:none}.popup-v5[data-editor-preview="true"] .popup-close{opacity:.25;pointer-events:none}.popup-v5[data-editor-preview="true"] .popup-event-option{cursor:default!important}
@media(max-width:760px){.popup-v5{--headline-x:0px!important;--subtitle-x:0px!important;--cards-x:0px!important;--continue-x:0px!important;padding:6px!important;align-items:center!important}.popup-v5 .event-popup-card{width:100%;max-width:100%;max-height:calc(100dvh - 12px);border-radius:18px}.popup-v5 .popup-head{position:sticky;top:0;z-index:12;min-height:48px;padding:9px 11px 8px;background:color-mix(in srgb,var(--popup-bg) 94%,transparent);backdrop-filter:blur(10px)}.popup-v5 .popup-head-brand{gap:8px;min-height:26px}.popup-v5 .popup-head-brand img{width:24px;height:24px;flex-basis:24px}.popup-v5 .popup-head-brand small{font-size:.56rem;transform:translateY(-1.5px)}.popup-v5 .popup-close{width:34px;height:34px}.popup-v5 .popup-layout{padding:10px 11px 12px;overflow:auto;overscroll-behavior:contain}.popup-v5 .popup-city,.popup-v5 .popup-multi-meta{margin:0 0 7px;padding:4px 7px;font-size:.43rem}.popup-v5 .popup-copy h2{font-size:clamp(1.75rem,8.1vw,2.28rem);line-height:.88;letter-spacing:-.035em}.popup-v5 .popup-subtitle{margin:7px 0 0;font-size:.68rem;line-height:1.38}.popup-v5 .popup-events{margin-top:10px}.popup-v5 .multiple-events{grid-template-columns:1fr;gap:8px}.popup-v5 .popup-event-option,.popup-v5 .single-event .popup-event-option{grid-template-columns:min(var(--media-width),88px) minmax(0,1fr);min-height:124px;border-radius:13px!important}.popup-v5 .popup-event-media{min-height:124px!important}.popup-v5 .popup-event-content{padding:10px 10px 9px}.popup-v5 .popup-event-meta{gap:7px;font-size:.42rem}.popup-v5 .popup-content-title{min-height:32px;margin-top:6px;transform:translateY(min(var(--card-title-y),8px))}.popup-v5 .popup-custom-title-text{font-size:1.2rem;line-height:.9}.popup-v5 .popup-custom-title-art{max-width:88%!important;max-height:38px!important}.popup-v5 .popup-event-place{gap:1px;margin-top:5px}.popup-v5 .popup-event-place small{font-size:.36rem}.popup-v5 .popup-event-place b{overflow:hidden;font-size:.55rem;line-height:1.2;text-overflow:ellipsis;white-space:nowrap}.popup-v5 .popup-event-footer{gap:7px;padding-top:6px}.popup-v5 .popup-event-footer small{font-size:.35rem}.popup-v5 .popup-event-footer b{font-size:.68rem}.popup-v5 .popup-event-cta{min-height:27px;padding:6px 8px;font-size:.41rem}.popup-v5 .popup-event-cta svg{width:11px;height:11px}.popup-v5 .popup-ticket-status{left:6px;top:6px;padding:4px 5px;font-size:.34rem}.popup-v5 .popup-ticket-status:before{width:4px;height:4px;margin-right:4px}.popup-v5 .popup-continue{margin:10px auto 0;padding:6px 8px;font-size:.49rem}.popup-v5 .popup-continue svg{width:12px;height:12px}}
@media(max-width:430px){.popup-v5{padding:4px!important}.popup-v5 .event-popup-card{max-height:calc(100dvh - 8px);border-radius:16px}.popup-v5 .popup-head{min-height:45px;padding:7px 9px}.popup-v5 .popup-layout{padding:8px 9px 10px}.popup-v5 .popup-copy h2{font-size:clamp(1.62rem,7.8vw,2.05rem)}.popup-v5 .popup-subtitle{font-size:.64rem}.popup-v5 .popup-events{margin-top:8px}.popup-v5 .popup-event-option,.popup-v5 .single-event .popup-event-option{grid-template-columns:min(var(--media-width),78px) minmax(0,1fr);min-height:114px}.popup-v5 .popup-event-media{min-height:114px!important}.popup-v5 .popup-event-content{padding:8px 9px}.popup-v5 .popup-event-meta{font-size:.38rem}.popup-v5 .popup-content-title{min-height:29px;margin-top:4px}.popup-v5 .popup-custom-title-text{font-size:1.08rem}.popup-v5 .popup-custom-title-art{max-height:34px!important}.popup-v5 .popup-event-place{margin-top:3px}.popup-v5 .popup-event-place small{display:none}.popup-v5 .popup-event-place b{font-size:.5rem}.popup-v5 .popup-event-footer{padding-top:5px}.popup-v5 .popup-event-footer>div{display:none}.popup-v5 .popup-event-cta{margin-left:auto}.popup-v5 .popup-ticket-status{font-size:.31rem}.popup-v5 .popup-continue{margin-top:8px}}
</style>
<script define:vars={{frequency,delayMs,editorPreview}}>
  const popup=document.querySelector('[data-event-popup]');
  const key='gtrz_event_popup_seen';
  const today=new Date().toISOString().slice(0,10);
  const storageRead=(kind,storageKey)=>{try{const storage=kind==='local'?window.localStorage:window.sessionStorage;return storage.getItem(storageKey)}catch{return null}};
  const storageWrite=(kind,storageKey,value)=>{try{const storage=kind==='local'?window.localStorage:window.sessionStorage;storage.setItem(storageKey,value)}catch{}};
  const handoff=storageRead('session','gtrz_language_handoff')==='1';
  if(handoff){try{sessionStorage.removeItem('gtrz_language_handoff')}catch{}}
  const seen=editorPreview?false:handoff?false:frequency==='always'?false:frequency==='day'?storageRead('local',key)===today:storageRead('session',key)==='1';
  const markSeen=()=>{if(editorPreview)return;if(frequency==='day')storageWrite('local',key,today);else if(frequency!=='always')storageWrite('session',key,'1')};
  const track=(name)=>{if(editorPreview)return;try{window.gtrzTrack?.(name,{section:'event_popup'})}catch{}};
  const clearHandoff=()=>document.documentElement.classList.remove('gtrz-popup-handoff');
  const closePopup=()=>{if(editorPreview||!popup)return;popup.hidden=true;popup.setAttribute('hidden','');popup.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open');clearHandoff();track('popup_close')};
  const openPopup=()=>{if(!popup){clearHandoff();return}const languageGate=document.querySelector('[data-language-gate]');if(!editorPreview&&languageGate&&!languageGate.hidden)return;popup.hidden=false;popup.removeAttribute('hidden');popup.setAttribute('aria-hidden','false');document.body.classList.add('modal-open');clearHandoff();markSeen();track('popup_view')};
  const schedulePopup=()=>{if(!popup||seen){clearHandoff();return}const languageGate=document.querySelector('[data-language-gate]');if(!editorPreview&&languageGate&&!languageGate.hidden)return;window.setTimeout(openPopup,editorPreview?0:(handoff?0:delayMs))};
  schedulePopup();
  popup?.querySelectorAll('[data-popup-close]').forEach(button=>button.addEventListener('click',event=>{if(editorPreview){event.preventDefault();return}closePopup()}));
  popup?.addEventListener('click',event=>{if(editorPreview){const link=event.target.closest?.('a');if(link)event.preventDefault();return}if(event.target===popup)closePopup()});
  addEventListener('keydown',event=>{if(event.key==='Escape'&&!popup?.hidden)closePopup()});
  window.setTimeout(clearHandoff,1800);

  if(editorPreview&&popup){
    document.documentElement.dataset.popupEditor='1';
    const css=(name,value)=>popup.style.setProperty(name,String(value));
    const text=(name,value)=>{const el=popup.querySelector(`[data-editor-text="${name}"]`);if(el&&value!=null)el.textContent=String(value)};
    const apply=(state)=>{
      const v={...(state?.visual||{})};
      text('kicker',v.kicker);text('titleTop',v.titleTop);text('titleBottom',v.titleBottom);text('subtitle',v.subtitle);text('continueText',v.continueText);
      const numeric=[['--popup-width','modalWidth','px'],['--headline-x','headlineX','px'],['--headline-y','headlineY','px'],['--subtitle-x','subtitleX','px'],['--subtitle-y','subtitleY','px'],['--cards-x','cardsX','px'],['--cards-y','cardsY','px'],['--continue-x','continueX','px'],['--continue-y','continueY','px'],['--card-title-y','cardTitleY','px'],['--media-width','cardMediaWidth','px'],['--card-height','cardHeight','px'],['--card-gap','gap','px']];
      numeric.forEach(([prop,keyName,unit])=>{if(v[keyName]!=null)css(prop,`${Number(v[keyName])}${unit}`)});
      const colors=[['--kicker-color','kickerColor'],['--title-color','titleColor'],['--highlight-color','highlightColor'],['--subtitle-color','subtitleColor'],['--continue-color','continueColor'],['--card-text','cardTextColor'],['--card-meta','cardMetaColor'],['--card-accent','cardAccent'],['--cta-bg','ctaBg'],['--cta-text','ctaText'],['--popup-bg','popupBg'],['--popup-border','popupBorder']];
      colors.forEach(([prop,keyName])=>{if(v[keyName])css(prop,v[keyName])});
      css('--headline-align',v.headlineAlign||'left');css('--subtitle-align',v.subtitleAlign||'left');
      const cont=popup.querySelector('[data-editor-block="continue"]');if(cont){const a=v.continueAlign||'center';cont.style.marginLeft=a==='left'?'0':'auto';cont.style.marginRight=a==='right'?'0':'auto'}
    };
    addEventListener('message',event=>{if(!event.origin.endsWith('gtrz.com.br')&&!event.origin.includes('localhost'))return;if(event.data?.type==='gtrz-popup-editor-state')apply(event.data.popup||{})});
    const map={headline:['--headline-x','--headline-y',120,80],subtitle:['--subtitle-x','--subtitle-y',120,80],cards:['--cards-x','--cards-y',80,60],continue:['--continue-x','--continue-y',120,60]};
    popup.querySelectorAll('[data-editor-block]').forEach(el=>{
      el.addEventListener('pointerdown',event=>{
        event.preventDefault();event.stopPropagation();
        const block=el.dataset.editorBlock;const cfg=map[block];if(!cfg)return;
        popup.querySelectorAll('[data-editor-block]').forEach(node=>node.classList.remove('editor-selected'));el.classList.add('editor-selected');
        parent.postMessage({type:'gtrz-popup-editor-select',block},'*');
        const startX=event.clientX,startY=event.clientY;
        const readVar=(name)=>Number.parseFloat(getComputedStyle(popup).getPropertyValue(name))||0;
        const baseX=readVar(cfg[0]),baseY=readVar(cfg[1]);let x=baseX,y=baseY;
        const move=ev=>{x=Math.max(-cfg[2],Math.min(cfg[2],baseX+ev.clientX-startX));y=Math.max(-cfg[3],Math.min(cfg[3],baseY+ev.clientY-startY));css(cfg[0],`${x}px`);css(cfg[1],`${y}px`)};
        const up=()=>{removeEventListener('pointermove',move);removeEventListener('pointerup',up);parent.postMessage({type:'gtrz-popup-editor-move',block,x,y},'*')};
        addEventListener('pointermove',move);addEventListener('pointerup',up,{once:true});
      });
    });
    parent.postMessage({type:'gtrz-popup-editor-ready'},'*');
  }
</script>
