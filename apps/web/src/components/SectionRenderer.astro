---
import type { CmsEvent,CmsSection,CmsTeamMember,Locale } from '@/lib/cms';
import Hero from './sections/Hero.astro';
import Marquee from './sections/Marquee.astro';
import About from './sections/About.astro';
import Rhythms from './sections/Rhythms.astro';
import Differentials from './sections/Differentials.astro';
import Events from './sections/Events.astro';
import Team from './sections/Team.astro';
import Freelancers from './sections/Freelancers.astro';
import Partnerships from './sections/Partnerships.astro';
import Manifesto from './sections/Manifesto.astro';
import Instagram from './sections/Instagram.astro';
import Contact from './sections/Contact.astro';
const {section,locale,events,team=[]}=Astro.props as {section:CmsSection;locale:Locale;events:CmsEvent[];team?:CmsTeamMember[]};
const props={locale,content:section.content,config:section.config,events,team};
---
{section.type==='hero'&&<><Hero {...props}/><Marquee locale={locale} content={section.content}/></>}
{section.type==='about'&&<About {...props}/>} 
{section.type==='rhythms'&&<Rhythms {...props}/>} 
{section.type==='differentials'&&<Differentials {...props}/>} 
{section.type==='events'&&<Events {...props}/>} 
{section.type==='team'&&<Team {...props}/>} 
{section.type==='freelancers'&&<Freelancers {...props}/>} 
{section.type==='partnerships'&&<><Partnerships {...props}/><Manifesto locale={locale} content={section.content}/></>} 
{section.type==='instagram'&&<Instagram {...props}/>} 
{section.type==='contact'&&<Contact {...props}/>} 
