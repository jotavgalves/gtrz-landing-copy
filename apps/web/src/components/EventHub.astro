---
import type { CmsEvent,Locale,SiteSettings } from '@/lib/cms';
import { API_BASE } from '@/lib/api';
import LanguageGate from '@/components/LanguageGate.astro';
import GtrzFooter from '@/components/GtrzFooter.astro';

const {events,locale,siteSettings={}}=Astro.props as {events:CmsEvent[];locale:Locale;siteSettings?:SiteSettings};
const es=locale==='es';
const instagram=typeof siteSettings.social?.instagram==='string'&&siteSettings.social.instagram
  ?String(siteSettings.social.instagram)
  :'https://instagram.com/gtrzeventos';
const activeEvents=events.filter(event=>['published','sales_open','sold_out'].includes(event.status)).slice(0,6);
const marqueeText='GTRZ · JOÃO PESSOA · RECIFE · LATIN MUSIC · EXPERIÊNCIAS ·';
const marqueeItems=Array.from({length:10});

const copy=es?{
  navEvents:'Eventos',
  navInstagram:'Instagram',
  navSuggestions:'Sugerencias',
  eyebrow:'AGENDA OFICIAL GTRZ',
  titleTop:'PRÓXIMAS',
  titleBottom:'NOCHES',
  intro:'Cada evento tiene una identidad propia. Elige dónde nos encontramos.',
  listLabel:'PRÓXIMOS EVENTOS',
  view:'VER EVENTO',
  coming:'PRÓXIMAMENTE',
  sales:'ENTRADAS DISPONIBLES',
  sold:'AGOTADO',
  emptyTitle:'NUEVAS FECHAS EN CAMINO',
  emptyBody:'Sigue a GTRZ para recibir primero los próximos anuncios.',
  emptyCta:'SEGUIR EN INSTAGRAM',
  feedbackEyebrow:'TU OPINIÓN',
  feedbackTitle:'AYÚDANOS A HACERLO MEJOR.',
  feedbackBody:'Ideas, críticas y sugerencias sobre nuestras fiestas. También puedes enviarlo de forma anónima.',
  feedbackCta:'ENVIAR SUGERENCIA',
  freelancerEyebrow:'OPORTUNIDADES',
  freelancerTitle:'SÉ PARTE DE LAS PRÓXIMAS PRODUCCIONES.',
  freelancerBody:'Estamos ampliando nuestra base de freelancers para los eventos GTRZ.',
  freelancerCta:'REGISTRO DE FREELANCERS',
  footer:'GTRZ EVENTOS · CULTURA LATINA EN MOVIMIENTO'
}:{
  navEvents:'Eventos',
  navInstagram:'Instagram',
  navSuggestions:'Sugestões',
  eyebrow:'AGENDA OFICIAL GTRZ',
  titleTop:'PRÓXIMAS',
  titleBottom:'NOITES',
  intro:'Cada evento tem uma identidade própria. Escolha onde a GTRZ te encontra.',
  listLabel:'PRÓXIMOS EVENTOS',
  view:'VER EVENTO',
  coming:'EM BREVE',
  sales:'INGRESSOS DISPONÍVEIS',
  sold:'ESGOTADO',
  emptyTitle:'NOVAS DATAS A CAMINHO',
  emptyBody:'Acompanhe a GTRZ para receber primeiro os próximos anúncios.',
  emptyCta:'SEGUIR NO INSTAGRAM',
  feedbackEyebrow:'SUA OPINIÃO',
  feedbackTitle:'AJUDE A GTRZ A FAZER MELHOR.',
  feedbackBody:'Ideias, críticas e sugestões sobre nossas festas. Você também pode enviar de forma anônima.',
  feedbackCta:'ENVIAR SUGESTÃO',
  freelancerEyebrow:'OPORTUNIDADES',
  freelancerTitle:'FAÇA PARTE DAS PRÓXIMAS PRODUÇÕES.',
  freelancerBody:'Estamos ampliando nossa base de freelancers para os eventos GTRZ.',
  freelancerCta:'CADASTRO DE FREELANCERS',
  footer:'GTRZ EVENTOS · CULTURA LATINA EM MOVIMENTO'
};

const parseTheme=(event:CmsEvent)=>{try{return JSON.parse(event.theme_json||'{}')}catch{return {}}};
const posterId=(event:CmsEvent)=>{
  const theme=parseTheme(event);
  return theme.hubCardMediaId||theme.hub_card_media_id||null;
};
const mediaUrl=(id?:string|null)=>id?`${API_BASE}/api/media/${encodeURIComponent(id)}`:'';
const formatDate=(iso:string)=>{
  try{
    return new Intl.DateTimeFormat(es?'es-ES':'pt-BR',{day:'2-digit',month:'short'}).format(new Date(iso)).replace('.','').toUpperCase();
  }catch{return ''}
};
const formatTime=(iso:string)=>{
  try{return new Intl.DateTimeFormat(es?'es-ES':'pt-BR',{hour:'2-digit',minute:'2-digit'}).format(new Date(iso))}
  catch{return ''}
};
const status=(event:CmsEvent)=>event.status==='sales_open'?copy.sales:event.status==='sold_out'?copy.sold:copy.coming;
const location=(event:CmsEvent)=>[event.city,event.state].filter(Boolean).join(' · ');

type EventPalette={accent:string;accent2:string;glow:string};
const eventPalette=(event:CmsEvent):EventPalette=>{
  const key=`${event.slug} ${event.title||''}`.toLowerCase();
  if(key.includes('misterio')||key.includes('mistério')){
    return {accent:'#51f27a',accent2:'#123a21',glow:'rgba(81,242,122,.22)'};
  }
  if(key.includes('macabra')||key.includes('perreo')){
    return {accent:'#ff7a1a',accent2:'#7d2cff',glow:'rgba(255,90,26,.24)'};
  }
  const theme=parseTheme(event);
  const raw=theme.accentColor||theme.accent||theme.primaryColor||theme.primary;
  if(typeof raw==='string'&&/^#[0-9a-f]{6}$/i.test(raw)){
    return {accent:raw,accent2:'#2a1212',glow:'rgba(255,36,26,.2)'};
  }
  return {accent:'#ff241a',accent2:'#3a1010',glow:'rgba(255,36,26,.2)'};
};

const heroEvents=activeEvents.slice(0,2).map(event=>({
  event,
  artwork:mediaUrl(posterId(event)),
  palette:eventPalette(event)
}));
const heroCities=[...new Set(activeEvents.map(event=>event.city).filter(Boolean))].slice(0,3).join(' · ');
const heroPeriod=activeEvents[0]?.starts_at?new Intl.DateTimeFormat(es?'es-ES':'pt-BR',{month:'long',year:'numeric'}).format(new Date(activeEvents[0].starts_at)).toUpperCase():'';
---
<LanguageGate locale={locale} chrome={siteSettings.chrome||{}} mode="hub" />
<div class="event-hub" id="top">
  <header class="hub-header">
    <a class="hub-brand" href="#top" aria-label="GTRZ Eventos" data-track="hub.logo">
      <img src="/brand/gtrz-wordmark.svg" alt="GTRZ" />
    </a>

    <nav class="hub-nav" aria-label={es?'Navegación':'Navegação'}>
      <a class="hub-nav-events" href="#eventos" data-track="hub.nav.events">{copy.navEvents}</a>
      <a class="hub-nav-suggestions" href={es?'/sugestoes?lang=es':'/sugestoes'} data-track="hub.nav.suggestions">{copy.navSuggestions}</a>
      <a class="hub-nav-instagram" href={instagram} target="_blank" rel="noreferrer" data-track="hub.nav.instagram">{copy.navInstagram}</a>
      <div class="hub-lang" aria-label="Idioma">
        <a class:list={{active:!es}} href="?lang=pt-BR" data-language="pt-BR" data-track="hub.lang.pt">PT</a>
        <a class:list={{active:es}} href="?lang=es" data-language="es" data-track="hub.lang.es">ES</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hub-hero">
      <div class="hub-hero-ambient" aria-hidden="true">
        <div class="hub-hero-light"></div>
        {heroEvents.map((item,index)=>(
          <div
            class:list={['hub-ghost-card',index===0?'ghost-a':'ghost-b',!item.artwork&&'ghost-fallback']}
            style={`--ghost-accent:${item.palette.accent};--ghost-accent-2:${item.palette.accent2};--ghost-glow:${item.palette.glow};--ghost-image:${item.artwork?`url('${item.artwork}')`:'none'}`}
          >
            <span>{item.event.title||item.event.slug}</span>
          </div>
        ))}
      </div>

      <div class="hub-edge-mark" aria-hidden="true"><span>GTRZ / 2026</span></div>

      <div class="hub-shell hub-hero-grid">
        <div class="hub-hero-copy">
          <div class="hub-eyebrow"><span></span>{copy.eyebrow}</div>
          <h1><span>{copy.titleTop}</span><strong>{copy.titleBottom}</strong></h1>
          {(heroCities||heroPeriod)&&(
            <div class="hub-hero-meta">
              {heroCities&&<span>{heroCities}</span>}
              {heroCities&&heroPeriod&&<i></i>}
              {heroPeriod&&<span>{heroPeriod}</span>}
            </div>
          )}
        </div>

        <div class="hub-intro">
          <div class="hub-intro-number">{activeEvents.length?'01':'00'}</div>
          <p>{copy.intro}</p>
          <a href="#eventos" class="hub-scroll" data-track="hub.hero.events">
            <span>{copy.navEvents}</span>
            <i aria-hidden="true">↓</i>
          </a>
        </div>
      </div>

      <div class="hub-marquee" aria-hidden="true">
        <div class="hub-marquee-track">
          <div class="hub-marquee-group">
            {marqueeItems.map(()=> <span>{marqueeText}</span>)}
          </div>
          <div class="hub-marquee-group">
            {marqueeItems.map(()=> <span>{marqueeText}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section class="hub-events hub-shell" id="eventos" data-section="events">
      <div class="hub-section-head">
        <div class="hub-section-number">01</div>
        <div class="hub-section-label">
          <span>{copy.listLabel}</span>
          <i></i>
        </div>
      </div>

      {activeEvents.length ? (
        <div class:list={['hub-event-grid',activeEvents.length===1&&'single']}>
          {activeEvents.map((event,index)=>{
            const artwork=mediaUrl(posterId(event));
            const eventLocation=location(event);
            const palette=eventPalette(event);
            return (
              <article
                class:list={['hub-event-card',index===0&&'lead',!artwork&&'no-art']}
                style={`--event-accent:${palette.accent};--event-accent-2:${palette.accent2};--event-glow:${palette.glow}`}
              >
                <a href={es?`/es/eventos/${event.slug}`:`/eventos/${event.slug}`} data-astro-prefetch="viewport" data-track={`hub.event.${event.slug}`} aria-label={`${copy.view}: ${event.title||event.slug}`}>
                  <div class="hub-event-visual">
                    {artwork
                      ? <img src={artwork} alt={event.title||event.slug} loading={index===0?'eager':'lazy'} />
                      : (
                        <div class="hub-event-generated" aria-hidden="true">
                          <div class="hub-event-orbit"></div>
                          <img src="/brand/gtrz-symbol.svg" alt="" />
                          <span>{event.title||event.slug}</span>
                        </div>
                      )}
                    <div class="hub-event-shade"></div>
                    <div class="hub-event-accent-line"></div>
                    <div class="hub-event-topline">
                      <span class:list={['hub-status',event.status==='sales_open'&&'sales',event.status==='sold_out'&&'sold']}>{status(event)}</span>
                      <span class="hub-event-index">{String(index+1).padStart(2,'0')}</span>
                    </div>
                  </div>

                  <div class="hub-event-info">
                    <div class="hub-event-meta">
                      <span>{eventLocation}</span>
                      <span>{formatDate(event.starts_at)} · {formatTime(event.starts_at)}</span>
                    </div>

                    <div class="hub-event-title-row">
                      <h2>{event.title||event.slug}</h2>
                      <svg class="hub-event-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M7 17 17 7M9 7h8v8" />
  </svg>
                    </div>

                    {event.venue_name&&<p>{event.venue_name}</p>}
                    <div class="hub-event-cta"><span>{copy.view}</span><i></i></div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="hub-empty">
          <img src="/brand/gtrz-symbol.svg" alt="" />
          <div><h2>{copy.emptyTitle}</h2><p>{copy.emptyBody}</p></div>
          <a href={instagram} target="_blank" rel="noreferrer" data-track="hub.empty.instagram">{copy.emptyCta}</a>
        </div>
      )}
    </section>

    <section class="hub-feedback hub-shell" data-section="feedback" aria-label={copy.feedbackEyebrow}>
      <div class="hub-feedback-inner">
        <div class="hub-feedback-marker">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 5.5h14v9H9.5L6 18v-3.5H5z" />
          </svg>
          <span>{copy.feedbackEyebrow}</span>
        </div>
        <div class="hub-feedback-copy">
          <strong>{copy.feedbackTitle}</strong>
          <p>{copy.feedbackBody}</p>
        </div>
        <a class="hub-feedback-link" href={es?'/sugestoes?lang=es':'/sugestoes'} data-track="hub.feedback">
          <span>{copy.feedbackCta}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
      </div>
    </section>

    <section class="hub-freelancers hub-shell" data-section="freelancers">
      <div class="hub-freelancers-inner">
        <div class="hub-freelancers-kicker">{copy.freelancerEyebrow}</div>
        <div class="hub-freelancers-copy">
          <h2>{copy.freelancerTitle}</h2>
          <p>{copy.freelancerBody}</p>
        </div>
        <a
          class="hub-freelancers-link"
          href={`/trabalhe-conosco?lang=${locale}`}
          data-track="hub.freelancers"
        >
          <span>{copy.freelancerCta}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <GtrzFooter locale={locale} settings={siteSettings} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-language]').forEach((link)=>{
    if (link.dataset.hubLanguageBound === '1') return;
    link.dataset.hubLanguageBound = '1';
    link.addEventListener('click',()=>{
      try {
        localStorage.setItem('gtrz_locale',link.dataset.language || 'pt-BR');
        localStorage.setItem('gtrz_language_gate_seen','1');
      } catch {}
    });
  });
</script>

<style>
  .event-hub{
    min-height:100vh;
    overflow:hidden;
    background:
      radial-gradient(circle at 88% 1%,rgba(255,36,26,.09),transparent 24rem),
      linear-gradient(180deg,#080808 0%,#060606 100%);
    color:var(--hub-white)
  }
  .hub-shell{width:calc(100% - 28px);max-width:1320px;margin-inline:auto}

  .hub-header{
    width:100%;
    max-width:none;
    height:68px;
    margin:0;
    padding-inline:max(14px,calc((100vw - 1320px)/2));
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    border-bottom:1px solid var(--hub-line);
    position:relative;
    z-index:20
  }
  .hub-brand{display:flex;align-items:center;min-width:0}
  .hub-brand img{width:88px}
  .hub-nav{display:flex;align-items:center;gap:14px;min-width:0;font-size:.59rem;font-weight:800;letter-spacing:.10em;text-transform:uppercase;color:#8f8884}
  .hub-nav a{white-space:nowrap}
  .hub-nav-events{display:none}
  .hub-nav-suggestions{display:none}
  .hub-nav-instagram{color:#c5bfbb}
  .hub-lang{
    display:flex;
    align-items:center;
    gap:3px;
    padding:3px;
    border:1px solid rgba(255,255,255,.11);
    border-radius:999px;
    background:#0e0e0e
  }
  .hub-lang a{
    min-width:34px;
    height:30px;
    padding:0 8px;
    border-radius:999px;
    display:grid;
    place-items:center;
    color:#625b59;
    font-size:.62rem;
    font-weight:950;
    letter-spacing:.08em;
    transition:.18s ease
  }
  .hub-lang a:hover{color:#fff}
  .hub-lang a.active{color:#fff;background:#222}

  .hub-hero{position:relative;padding-top:38px;isolation:isolate}
  .hub-hero-grid{position:relative;z-index:3;display:grid;grid-template-columns:1fr;gap:24px}
  .hub-hero-ambient{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}
  .hub-hero-light{
    position:absolute;
    right:-18%;
    top:-14%;
    width:28rem;
    height:28rem;
    border-radius:50%;
    background:radial-gradient(circle,rgba(255,36,26,.13),rgba(255,36,26,.035) 36%,transparent 70%);
    filter:blur(10px)
  }
  .hub-ghost-card{
    position:absolute;
    width:150px;
    aspect-ratio:3/4;
    border:1px solid color-mix(in srgb,var(--ghost-accent) 28%,transparent);
    background-image:
      linear-gradient(180deg,rgba(7,7,7,.34),rgba(7,7,7,.92)),
      var(--ghost-image),
      radial-gradient(circle at 50% 42%,var(--ghost-glow),transparent 64%);
    background-size:cover;
    background-position:center;
    box-shadow:0 0 65px var(--ghost-glow);
    opacity:.17;
    filter:saturate(.75) contrast(1.05);
    transform:rotate(7deg)
  }
  .hub-ghost-card span{
    position:absolute;
    left:10px;
    bottom:9px;
    max-width:86%;
    overflow:hidden;
    color:var(--ghost-accent);
    font-family:'Barlow Condensed','Arial Narrow',sans-serif;
    font-size:1.5rem;
    font-weight:900;
    line-height:.8;
    text-transform:uppercase
  }
  .ghost-a{right:5%;top:8%}
  .ghost-b{right:-8%;top:31%;transform:rotate(-8deg);opacity:.12}
  .ghost-fallback{
    background-image:
      linear-gradient(135deg,var(--ghost-accent-2),#090909 62%),
      radial-gradient(circle at 45% 35%,var(--ghost-glow),transparent 60%)
  }
  .hub-edge-mark{display:none}
  .hub-eyebrow{display:flex;align-items:center;gap:10px;color:#a9a29e;font-size:.60rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .hub-eyebrow span{width:24px;height:2px;background:var(--hub-red);flex:none}
  .hub-hero h1{
    margin:16px 0 0;
    max-width:100%;
    font-family:'Barlow Condensed','Arial Narrow',sans-serif;
    font-size:clamp(3.75rem,18.5vw,5.6rem);
    font-weight:900;
    line-height:.80;
    letter-spacing:-.038em;
    text-transform:uppercase
  }
  .hub-hero h1 span,.hub-hero h1 strong{display:block}
  .hub-hero h1 strong{color:var(--hub-red);font-weight:900}
  .hub-hero-meta{display:flex;align-items:center;gap:10px;margin-top:20px;color:#6f6864;font-size:.54rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .hub-hero-meta i{width:18px;height:1px;background:#36312f}
  .hub-intro{max-width:32rem;position:relative}
  .hub-intro-number{display:none;color:rgba(255,255,255,.06);font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-size:4rem;font-weight:900;line-height:1}
  .hub-intro p{margin:0;color:#a69e9a;font-size:.94rem;line-height:1.65}
  .hub-scroll{display:inline-flex;align-items:center;gap:12px;margin-top:20px;font-size:.61rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .hub-scroll i{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--hub-line);border-radius:50%;color:var(--hub-red);font-style:normal}

  .hub-marquee{
    width:100%;
    margin-top:34px;
    overflow:hidden;
    padding:11px 0;
    border-top:1px solid var(--hub-line);
    border-bottom:1px solid var(--hub-line);
    color:#514c49;
    font-size:.54rem;
    font-weight:800;
    letter-spacing:.14em;
    white-space:nowrap;
    position:relative;
    z-index:5
  }
  .hub-marquee-track{
    display:flex;
    width:max-content;
    will-change:transform;
    animation:hub-marquee 96s linear infinite
  }
  .hub-marquee-group{display:flex;align-items:center;flex:none;width:max-content}
  .hub-marquee-group span{flex:none;padding-left:34px}
  @keyframes hub-marquee{to{transform:translateX(-50%)}}

  .hub-events{padding-top:42px;padding-bottom:68px;position:relative}
  .hub-section-head{display:grid;grid-template-columns:38px minmax(0,1fr);gap:14px;align-items:center;margin-bottom:18px}
  .hub-section-number{
    font-family:'Barlow Condensed','Arial Narrow',sans-serif;
    color:var(--hub-red);
    font-size:1.65rem;
    font-weight:900;
    line-height:1
  }
  .hub-section-label{display:grid;grid-template-columns:auto minmax(30px,1fr);align-items:center;gap:12px;color:#a39c98;font-size:.59rem;font-weight:800;letter-spacing:.12em}
  .hub-section-label span{white-space:nowrap}.hub-section-label i{height:1px;background:var(--hub-line)}

  .hub-event-grid{display:grid;grid-template-columns:1fr;gap:14px}
  .hub-event-card{
    min-width:0;
    border:1px solid rgba(255,255,255,.12);
    background:#0a0a0a;
    overflow:hidden;
    position:relative
  }
  .hub-event-card::before{
    content:'';
    position:absolute;
    inset:auto -10% -45% 22%;
    height:65%;
    background:radial-gradient(circle,var(--event-glow),transparent 68%);
    opacity:.55;
    pointer-events:none
  }
  .hub-event-card>a{display:block;position:relative;z-index:1}
  .hub-event-visual{
    position:relative;
    min-height:190px;
    aspect-ratio:16/9;
    overflow:hidden;
    background:
      linear-gradient(135deg,color-mix(in srgb,var(--event-accent-2) 76%,#080808),#080808 62%)
  }
  .hub-event-visual>img{width:100%;height:100%;object-fit:cover}
  .hub-event-generated{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
  .hub-event-generated::before{
    content:'';
    position:absolute;
    width:72%;
    aspect-ratio:1;
    border-radius:50%;
    border:1px solid color-mix(in srgb,var(--event-accent) 28%,transparent);
    box-shadow:0 0 72px var(--event-glow),inset 0 0 72px color-mix(in srgb,var(--event-accent) 7%,transparent)
  }
  .hub-event-generated::after{
    content:'';
    position:absolute;
    inset:12% -15%;
    background:linear-gradient(108deg,transparent 33%,color-mix(in srgb,var(--event-accent) 12%,transparent) 48%,transparent 62%);
    transform:rotate(-7deg)
  }
  .hub-event-generated img{position:relative;z-index:2;width:54px;opacity:.85}
  .hub-event-generated span{
    position:absolute;
    left:14px;
    right:14px;
    bottom:-5px;
    color:color-mix(in srgb,var(--event-accent) 18%,transparent);
    font-family:'Barlow Condensed','Arial Narrow',sans-serif;
    font-size:clamp(4rem,22vw,7rem);
    font-weight:900;
    line-height:.75;
    letter-spacing:-.04em;
    text-transform:uppercase;
    white-space:nowrap
  }
  .hub-event-orbit{
    position:absolute;
    width:42%;
    aspect-ratio:1;
    border-radius:50%;
