{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gtrz-control",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "control.gtrz.com.br",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
